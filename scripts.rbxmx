]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<token name="RunContext">0</token>
				<string name="ScriptGuid">{B8A8ADA2-E191-4BC1-9959-9971087D5942}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<string name="Name">Server</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			</Properties>
		</Item>
	</Item>
	<Item class="StarterPlayerScripts" referent="RBX0AB11AD1B5494A949826FE1FB621FD6B">
		<Properties>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
			<bool name="DefinesCapabilities">false</bool>
			<string name="Name">StarterPlayerScripts</string>
			<BinaryString name="SerializedOverrides"></BinaryString>
			<int64 name="SourceAssetId">-1</int64>
			<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
		</Properties>
		<Item class="LocalScript" referent="RBX03F896B2119242F4885B8EE9AF76EC38">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--[[
	Ragdoll Ronin - client bootstrap.
	The client only samples input, runs the camera, draws UI and sends intent. It never decides
	hits, damage or death (see ServerScriptService.RagdollRonin).
]]
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("RagdollRonin")
local Remotes = Shared:WaitForChild("Remotes")

local CameraController = require(script.CameraController)
local InputController = require(script.InputController)
local CombatCursorUI = require(script.CombatCursorUI)
local AnatomyUI = require(script.AnatomyUI)
local DebugOverlay = require(script.DebugOverlay)

-- default Roblox movement controls are irrelevant for the custom fighter
task.spawn(function()
	local ok, pm = pcall(function()
		return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 10))
	end)
	if ok and pm then
		pcall(function()
			pm:GetControls():Disable()
		end)
	end
end)

-- Escape menu "Reset Character" -> server-side death (no Humanoid exists to kill)
task.spawn(function()
	local resetEvent = Instance.new("BindableEvent")
	resetEvent.Event:Connect(function()
		Remotes.CombatAction:FireServer("Reset")
	end)
	for _ = 1, 20 do
		if pcall(StarterGui.SetCore, StarterGui, "ResetButtonCallback", resetEvent) then
			break
		end
		task.wait(0.5)
	end
end)

local gui = Instance.new("ScreenGui")
gui.Name = "RagdollRoninHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.DisplayOrder = 5
gui.Parent = player:WaitForChild("PlayerGui")

local ctx = {
	Player = player,
	Gui = gui,
	Remotes = Remotes,
	Fighter = nil,
}

local function isFighter(model)
	return model ~= nil and model:GetAttribute("RR_Fighter") == true
end

local function onCharacter(model)
	if isFighter(model) then
		ctx.Fighter = model
		CameraController.OnNewFighter(ctx, model)
		CombatCursorUI.OnNewFighter(ctx, model)
		AnatomyUI.OnNewFighter(ctx, model)
	end
end
player:GetPropertyChangedSignal("Character"):Connect(function()
	onCharacter(player.Character)
end)

CameraController.Init(ctx)
InputController.Init(ctx)
CombatCursorUI.Init(ctx)
AnatomyUI.Init(ctx)
DebugOverlay.Init(ctx)
onCharacter(player.Character)

RunService:BindToRenderStep("RR_Input", Enum.RenderPriority.Input.Value + 1, function(dt)
	InputController.Update(ctx, dt)
end)
RunService:BindToRenderStep("RR_Camera", Enum.RenderPriority.Camera.Value + 2, function(dt)
	CameraController.Update(ctx, dt)
	InputController.ApplyMouseMode(ctx)
end)
RunService:BindToRenderStep("RR_UI", Enum.RenderPriority.Last.Value, function(dt)
	CombatCursorUI.Update(ctx, dt)
	AnatomyUI.Update(ctx, dt)
	DebugOverlay.Update(ctx, dt)
end)
]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<token name="RunContext">0</token>
				<string name="ScriptGuid">{92BD424B-686D-4305-898C-B67C7F96EA94}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<string name="Name">RagdollRoninClient</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			</Properties>
			<Item class="ModuleScript" referent="RBX35C3B0E7870F413C8F1C7D56E6962369">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--[[
	CameraController: over-the-shoulder third-person camera (Scriptable).
	Yaw/pitch are changed by mouse movement ONLY while no sword button is held; while M1/M2 are
	held the mouse drives the combat cursor instead and the camera (and therefore facing) holds.
	The camera yaw is sent to the server as the desired facing.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("RagdollRonin"):WaitForChild("Config"))

local CameraController = {}
local CC = Config.Camera

local params = RaycastParams.new()
params.CollisionGroup = "RR_GroundQuery" -- world geometry only (never fighters, swords or debris)
params.IgnoreWater = true

function CameraController.Init(ctx)
	ctx.Camera = { Yaw = 0, Pitch = -0.2, Focus = nil }
end

function CameraController.OnNewFighter(ctx, model)
	local pelvis = model:WaitForChild("LowerTorso", 5)
	if pelvis then
		local look = pelvis.CFrame.LookVector
		ctx.Camera.Yaw = math.atan2(-look.X, -look.Z)
		ctx.Camera.Focus = nil
	end
end

function CameraController.Rotate(ctx, dx, dy)
	local c = ctx.Camera
	c.Yaw = (c.Yaw - dx * Config.Aim.CameraSensitivity) % (2 * math.pi)
	c.Pitch = math.clamp(c.Pitch - dy * Config.Aim.CameraSensitivity, CC.MinPitch, CC.MaxPitch)
end

function CameraController.Update(ctx, dt)
	local cam = workspace.CurrentCamera
	if cam.CameraType ~= Enum.CameraType.Scriptable then
		cam.CameraType = Enum.CameraType.Scriptable
	end
	local model = ctx.Fighter
	local focusPart = model and (model:FindFirstChild("UpperTorso") or model:FindFirstChild("LowerTorso"))
	if not focusPart then
		return
	end
	local c = ctx.Camera
	local target = focusPart.Position + Vector3.new(0, CC.FocusHeight, 0)
	if not c.Focus or (c.Focus - target).Magnitude > 30 then
		c.Focus = target
	else
		c.Focus = c.Focus:Lerp(target, 1 - math.exp(-CC.FollowSharpness * dt))
	end
	local rot = CFrame.Angles(0, c.Yaw, 0) * CFrame.Angles(c.Pitch, 0, 0)
	local desired = c.Focus + rot:VectorToWorldSpace(CC.Offset)
	local hit = workspace:Raycast(c.Focus, desired - c.Focus, params)
	if hit then
		desired = hit.Position + hit.Normal * 0.3
	end
	cam.CFrame = CFrame.new(desired) * rot
end

return CameraController
]]></ProtectedString>
					<string name="ScriptGuid">{993035CF-40C9-47F6-9009-90F03BC2199F}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">CameraController</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXC2C7BC0DA60149F491A60B4687796A9D">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--[[
	InputController: samples input and sends INTENT to the server (~30 Hz, unreliable channel).

	Mouse mapping (mouse is locked to the screen centre, raw deltas are used, so it works the same
	in every mouse mode and on any resolution):
	  * no button held: mouse turns the camera; the fighter turns to face the camera yaw
	  * M1 held: mouse moves the combat cursor (unit disk) -> continuous sword control
	  * M2 held: mouse moves the combat cursor -> guard placement
	  * releasing both: the cursor relaxes back to the ready stance (the server does the same)
	Packet: seq, moveX, moveZ, yaw, aimU, aimV, buttons (bit0 = M1, bit1 = M2)
]]
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("RagdollRonin"):WaitForChild("Config"))
local CameraController = require(script.Parent.CameraController)

local InputController = {}
local A = Config.Aim

function InputController.Init(ctx)
	local s = {
		AimU = A.ReadyU,
		AimV = A.ReadyV,
		M1 = false,
		M2 = false,
		Move = Vector3.zero,
		History = {},
		Seq = 0,
		LastSend = 0,
		PressTime = 0,
	}
	ctx.Input = s

	UserInputService.InputBegan:Connect(function(io, processed)
		if processed or GuiService.MenuIsOpen then
			return
		end
		if io.UserInputType == Enum.UserInputType.MouseButton1 then
			s.M1 = true
			s.PressTime = os.clock()
		elseif io.UserInputType == Enum.UserInputType.MouseButton2 then
			s.M2 = true
			s.PressTime = os.clock()
		elseif io.KeyCode == Enum.KeyCode.Space then
			ctx.Remotes.CombatAction:FireServer("Recover")
		end
	end)
	UserInputService.InputEnded:Connect(function(io)
		if io.UserInputType == Enum.UserInputType.MouseButton1 then
			s.M1 = false
		elseif io.UserInputType == Enum.UserInputType.MouseButton2 then
			s.M2 = false
		end
	end)
end

local function key(k)
	return UserInputService:IsKeyDown(k) and 1 or 0
end

function InputController.Update(ctx, dt)
	local s = ctx.Input
	local blocked = GuiService.MenuIsOpen or UserInputService:GetFocusedTextBox() ~= nil
	if GuiService.MenuIsOpen then
		s.M1, s.M2 = false, false
	end

	local delta = blocked and Vector2.zero or UserInputService:GetMouseDelta()
	if s.M1 or s.M2 then
		s.AimU += delta.X * A.ClientSensitivity
		s.AimV -= delta.Y * A.ClientSensitivity
		local r = math.sqrt(s.AimU * s.AimU + s.AimV * s.AimV)
		if r > 1 then
			s.AimU, s.AimV = s.AimU / r, s.AimV / r
		end
	else
		CameraController.Rotate(ctx, delta.X, delta.Y)
		local k = math.min(1, 8 * dt)
		s.AimU += (A.ReadyU - s.AimU) * k
		s.AimV += (A.ReadyV - s.AimV) * k
	end

	local mv = Vector3.zero
	if not blocked then
		local fwd = key(Enum.KeyCode.W) - key(Enum.KeyCode.S)
		local right = key(Enum.KeyCode.D) - key(Enum.KeyCode.A)
		mv = Vector3.new(right, 0, -fwd)
		if mv.Magnitude > 0 then
			mv = mv.Unit
		end
	end
	s.Move = CFrame.Angles(0, ctx.Camera.Yaw, 0):VectorToWorldSpace(mv)

	local now = os.clock()
	table.insert(s.History, { t = now, u = s.AimU, v = s.AimV })
	while #s.History > 2 and now - s.History[1].t > 0.3 do
		table.remove(s.History, 1)
	end

	if now - s.LastSend >= 1 / Config.Network.ClientSendRate then
		s.LastSend = now
		s.Seq += 1
		local buttons = (s.M1 and 1 or 0) + (s.M2 and 2 or 0)
		ctx.Remotes.CombatInput:FireServer(s.Seq, s.Move.X, s.Move.Z, ctx.Camera.Yaw, s.AimU, s.AimV, buttons)
	end
end

-- Recent cursor motion (disk units per second) over the last `window` seconds
function InputController.MotionVector(ctx, window)
	local h = ctx.Input.History
	local n = #h
	if n < 2 then
		return 0, 0
	end
	local last = h[n]
	local first = h[1]
	for i = n - 1, 1, -1 do
		if last.t - h[i].t >= window then
			first = h[i]
			break
		end
	end
	local dt = math.max(last.t - first.t, 1e-3)
	return (last.u - first.u) / dt, (last.v - first.v) / dt
end

function InputController.ApplyMouseMode(ctx)
	local free = GuiService.MenuIsOpen
	UserInputService.MouseBehavior = free and Enum.MouseBehavior.Default or Enum.MouseBehavior.LockCenter
	UserInputService.MouseIconEnabled = free
end

return InputController
]]></ProtectedString>
					<string name="ScriptGuid">{43905311-EEB4-4E41-9886-07B9D694F657}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">InputController</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX27F8F2E0DF264716A6A31200A70F7CEB">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--[[
	CombatCursorUI: shows exactly the input the combat controller uses.
	  ring        the combat disk (visible while M1/M2 are held)
	  cursor dot  the intended sword position (same u, v that is sent to the server)
	  blade line  attack: centre -> cursor, the direction the blade will point;
	              guard: a bar across the cursor showing how the guard will lie
	  trail/arrow recent cursor motion = swing direction (the edge follows it)
	  diamond     where the server-simulated blade tip actually is (projected), showing lag/inertia
	Colours follow the server's AttackPhase: Ready/Guiding (white/amber), Swing (red),
	Guard (blue), Recoil (violet). Feedback text flashes for blocks, parries, interrupts, hits.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("RagdollRonin")
local Config = require(Shared:WaitForChild("Config"))
local InputController = require(script.Parent.InputController)

local CombatCursorUI = {}

local COLORS = {
	Ready = Color3.fromRGB(235, 235, 235),
	Guiding = Color3.fromRGB(255, 200, 90),
	Swing = Color3.fromRGB(255, 70, 50),
	Guard = Color3.fromRGB(90, 170, 255),
	Recoil = Color3.fromRGB(190, 120, 255),
	Unarmed = Color3.fromRGB(140, 140, 140),
	Disabled = Color3.fromRGB(120, 120, 120),
}
local TRAIL = 6

local ui = {}

local function circle(parent, size, color, transp)
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Size = UDim2.fromOffset(size, size)
	f.BackgroundColor3 = color
	f.BackgroundTransparency = transp or 0
	f.BorderSizePixel = 0
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = f
	f.Parent = parent
	return f
end

local function line(parent, thickness, color)
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color
	f.Size = UDim2.fromOffset(1, thickness)
	f.Parent = parent
	return f
end

local function placeLine(l, a, b, thickness)
	local d = b - a
	local len = d.Magnitude
	l.Visible = len > 1
	l.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
	l.Size = UDim2.fromOffset(len, thickness)
	l.Rotation = math.deg(math.atan2(d.Y, d.X))
end

function CombatCursorUI.Init(ctx)
	local root = Instance.new("Frame")
	root.Name = "CombatCursor"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.Parent = ctx.Gui
	ui.Root = root

	local ring = circle(root, 100, Color3.new(1, 1, 1), 1)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 1.5
	stroke.Transparency = 0.6
	stroke.Color = Color3.new(1, 1, 1)
	stroke.Parent = ring
	ui.Ring, ui.RingStroke = ring, stroke
	ui.Center = circle(root, 4, Color3.new(1, 1, 1), 0.4)
	ui.Blade = line(root, 2, Color3.new(1, 1, 1))
	ui.Guard = line(root, 4, COLORS.Guard)
	ui.Trail = {}
	for i = 1, TRAIL do
		ui.Trail[i] = circle(root, 4, Color3.new(1, 1, 1), 0.5)
	end
	ui.Arrow = line(root, 2, Color3.new(1, 1, 1))
	local head = Instance.new("Frame")
	head.AnchorPoint = Vector2.new(0.5, 0.5)
	head.Size = UDim2.fromOffset(8, 8)
	head.BorderSizePixel = 0
	head.Rotation = 45
	head.Parent = root
	ui.ArrowHead = head
	ui.Cursor = circle(root, 10, Color3.new(1, 1, 1), 0)
	local cs = Instance.new("UIStroke")
	cs.Thickness = 1.5
	cs.Color = Color3.new(0, 0, 0)
	cs.Transparency = 0.3
	cs.Parent = ui.Cursor
	local tip = Instance.new("Frame")
	tip.AnchorPoint = Vector2.new(0.5, 0.5)
	tip.Size = UDim2.fromOffset(7, 7)
	tip.Rotation = 45
	tip.BackgroundTransparency = 1
	local ts = Instance.new("UIStroke")
	ts.Thickness = 1.5
	ts.Color = Color3.new(1, 1, 1)
	ts.Parent = tip
	tip.Parent = root
	ui.Tip, ui.TipStroke = tip, ts

	local label = Instance.new("TextLabel")
	label.AnchorPoint = Vector2.new(0.5, 0)
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromOffset(240, 26)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 18
	label.TextStrokeTransparency = 0.4
	label.TextColor3 = Color3.new(1, 1, 1)
	label.Text = ""
	label.Parent = root
	ui.Label = label
	ui.LabelUntil = 0

	local death = Instance.new("TextLabel")
	death.AnchorPoint = Vector2.new(0.5, 0.5)
	death.Position = UDim2.fromScale(0.5, 0.35)
	death.Size = UDim2.fromOffset(600, 60)
	death.BackgroundTransparency = 1
	death.Font = Enum.Font.GothamBlack
	death.TextSize = 30
	death.TextColor3 = Color3.fromRGB(220, 40, 40)
	death.TextStrokeTransparency = 0.3
	death.Visible = false
	death.Parent = root
	ui.Death = death

	ctx.Remotes.CombatFeedback.OnClientEvent:Connect(function(kind, info)
		CombatCursorUI.Flash(ctx, kind, info or {})
	end)
end

function CombatCursorUI.OnNewFighter(ctx, model)
	ui.Death.Visible = false
	ui.DeathUntil = nil
end

local MESSAGES = {
	AttackBlocked = { "BLOCKED", COLORS.Guard },
	AttackParried = { "PARRIED!", Color3.fromRGB(255, 120, 255) },
	AttackGlanced = { "GLANCED OFF GUARD", COLORS.Guiding },
	GuardBroken = { "GUARD BROKEN", COLORS.Swing },
	BladeBeaten = { "BLADE BEATEN ASIDE", COLORS.Guiding },
	Clash = { "CLASH", Color3.fromRGB(255, 230, 120) },
	Blocked = { "BLOCK", COLORS.Guard },
	Parried = { "PARRY!", Color3.fromRGB(120, 255, 200) },
	GuardGlanced = { "GUARD SLIPPED", COLORS.Swing },
	GuardOverpowered = { "GUARD OVERPOWERED", COLORS.Swing },
	BladeKnockedAside = { "BLADE KNOCKED ASIDE", COLORS.Swing },
	Interrupted = { "INTERRUPTED", COLORS.Swing },
	KnockedDown = { "KNOCKED DOWN", COLORS.Swing },
	Contact = { "touch", Color3.fromRGB(200, 200, 200) },
}

function CombatCursorUI.Flash(ctx, kind, info)
	local text, color
	if kind == "Hit" then
		text = (info.Severed and "SEVERED " or "") .. string.upper(info.Label or "HIT") .. (info.Fatal and " - LETHAL" or "")
		color = info.Severed and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(255, 160, 120)
	elseif kind == "Hurt" then
		text = "HIT: " .. (info.Label or "") .. (info.Severed and " (SEVERED)" or "")
		color = Color3.fromRGB(255, 80, 80)
	elseif kind == "Killed" then
		text = "KILLED " .. tostring(info.Target)
		color = Color3.fromRGB(255, 60, 60)
	elseif kind == "Died" then
		ui.DeathBase = "YOU DIED - " .. tostring(info.Reason)
		ui.Death.Text = ui.DeathBase
		ui.Death.Visible = true
		ui.DeathUntil = os.clock() + (info.Respawn or 5)
		return
	else
		local m = MESSAGES[kind]
		if not m then
			return
		end
		text, color = m[1], m[2]
	end
	ui.Label.Text = text
	ui.Label.TextColor3 = color
	ui.LabelUntil = os.clock() + 0.9
	ui.FlashColor = color
	ui.FlashUntil = os.clock() + 0.25
end

function CombatCursorUI.Update(ctx, dt)
	local cam = workspace.CurrentCamera
	local vp = cam.ViewportSize
	local R = math.floor(math.min(vp.X, vp.Y) * 0.17)
	local s = ctx.Input
	if not s then
		return
	end
	local model = ctx.Fighter
	-- anchor the combat disk in front of the fighter's chest so the cursor sits where the sword goes
	local center = Vector2.new(vp.X * 0.5, vp.Y * 0.52)
	local ut = model and model:FindFirstChild("UpperTorso")
	local pelvis = model and model:FindFirstChild("LowerTorso")
	if ut and pelvis then
		local look = pelvis.CFrame.LookVector
		local fwd = Vector3.new(look.X, 0, look.Z)
		fwd = fwd.Magnitude > 0.1 and fwd.Unit or Vector3.zero
		local p, onScreen = cam:WorldToViewportPoint(ut.Position + fwd * 1.6 + Vector3.new(0, 0.25, 0))
		if onScreen then
			local target = Vector2.new(p.X, p.Y)
			ui.Anchor = ui.Anchor and ui.Anchor:Lerp(target, math.min(1, 12 * dt)) or target
			center = ui.Anchor
		end
	end
	local state = model and model:GetAttribute("State") or "Idle"
	local phase = model and model:GetAttribute("AttackPhase") or "Ready"
	local disabled = state == "Dead" or state == "Falling" or state == "GroundedRecovery" or state == "SeverelyInjured" or state == "Recovering"
	local active = s.M1 or s.M2
	local color = disabled and COLORS.Disabled or (COLORS[phase] or COLORS.Ready)
	if s.M2 and not disabled and phase ~= "Unarmed" then
		color = COLORS.Guard
	end
	local now = os.clock()
	if ui.FlashUntil and now < ui.FlashUntil then
		color = ui.FlashColor
	end

	ui.Ring.Position = UDim2.fromOffset(center.X, center.Y)
	ui.Ring.Size = UDim2.fromOffset(R * 2, R * 2)
	ui.RingStroke.Color = color
	ui.RingStroke.Transparency = active and 0.35 or 0.85
	ui.Center.Position = UDim2.fromOffset(center.X, center.Y)

	local cur = center + Vector2.new(s.AimU, -s.AimV) * R
	ui.Cursor.Position = UDim2.fromOffset(cur.X, cur.Y)
	ui.Cursor.BackgroundColor3 = color
	ui.Cursor.Size = UDim2.fromOffset(active and 12 or 8, active and 12 or 8)

	-- intended sword direction
	if s.M2 then
		ui.Blade.Visible = false
		local r = math.sqrt(s.AimU ^ 2 + s.AimV ^ 2)
		local radial = r > 0.2 and Vector2.new(s.AimU, -s.AimV) / r or Vector2.new(0, -1)
		local across = Vector2.new(-radial.Y, radial.X)
		placeLine(ui.Guard, cur - across * R * 0.45, cur + across * R * 0.45, 4)
		ui.Guard.BackgroundColor3 = color
	else
		ui.Guard.Visible = false
		placeLine(ui.Blade, center, cur, 2)
		ui.Blade.BackgroundColor3 = color
		ui.Blade.BackgroundTransparency = active and 0.2 or 0.7
	end

	-- motion trail + arrow (swing direction)
	local h = s.History
	for i = 1, TRAIL do
		local sample = h[math.max(1, #h - (i * 2))]
		local dot = ui.Trail[i]
		if sample and active then
			dot.Visible = true
			dot.Position = UDim2.fromOffset(center.X + sample.u * R, center.Y - sample.v * R)
			dot.BackgroundColor3 = color
			dot.BackgroundTransparency = 0.3 + i * 0.1
		else
			dot.Visible = false
		end
	end
	local mu, mv = InputController.MotionVector(ctx, 0.08)
	local speed = math.sqrt(mu * mu + mv * mv)
	if active and speed > 0.6 then
		local dir = Vector2.new(mu, -mv) / speed
		local len = math.clamp(speed * 10, 14, 60)
		local tipPos = cur + dir * len
		placeLine(ui.Arrow, cur, tipPos, 2)
		ui.Arrow.BackgroundColor3 = color
		ui.ArrowHead.Visible = true
		ui.ArrowHead.Position = UDim2.fromOffset(tipPos.X, tipPos.Y)
		ui.ArrowHead.BackgroundColor3 = color
	else
		ui.Arrow.Visible = false
		ui.ArrowHead.Visible = false
	end

	-- actual blade tip (server simulated, replicated)
	local blade = model and model:FindFirstChild("Katana") and model.Katana:FindFirstChild("Blade")
	if blade then
		local p, onScreen = cam:WorldToViewportPoint(blade.CFrame:PointToWorldSpace(Vector3.new(0, blade.Size.Y / 2, 0)))
		ui.Tip.Visible = onScreen
		ui.Tip.Position = UDim2.fromOffset(p.X, p.Y)
		ui.TipStroke.Color = color
	else
		ui.Tip.Visible = false
	end

	ui.Label.Position = UDim2.fromOffset(center.X, center.Y + R + 10)
	ui.Label.Visible = now < ui.LabelUntil
	if ui.DeathUntil then
		local left = math.max(0, ui.DeathUntil - now)
		ui.Death.Text = (ui.DeathBase or "") .. string.format("   respawn in %.0f", left)
	end
end

return CombatCursorUI
]]></ProtectedString>
					<string name="ScriptGuid">{7E7B1991-8490-4C9A-8AFF-88D68D2ABAAD}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">CombatCursorUI</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX56832B219F8E4E4EB43581D2E58C798C">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--[[
	AnatomyUI: bottom-centre condition display (replaces a health bar).
	  * silhouette built from the shared Anatomy layout, seen from behind (your right is on the right)
	    segment colour = integrity; red outline = bleeding; hollow + x = severed/lost
	  * organs drawn at their anatomical positions, coloured by health
	  * separate blood meter (volume, incapacitation + lethal marks, bleed rate)
	  * short list of the most serious injuries and the current state
	Driven only by the server's AnatomyUpdate snapshots.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("RagdollRonin")
local Config = require(Shared:WaitForChild("Config"))
local Anatomy = require(Shared:WaitForChild("Anatomy"))

local AnatomyUI = {}

local K = 16 -- pixels per unscaled stud in the silhouette
local C_OK = Color3.fromRGB(150, 168, 150)
local C_HURT = Color3.fromRGB(226, 200, 80)
local C_SEVERE = Color3.fromRGB(235, 130, 40)
local C_CRIT = Color3.fromRGB(215, 40, 40)
local C_LOST = Color3.fromRGB(40, 40, 44)
local C_BLEED = Color3.fromRGB(255, 30, 30)

local ui = { Segments = {}, Organs = {} }
local snapshot

local function integrityColor(frac)
	if frac >= 0.85 then
		return C_OK
	elseif frac >= 0.6 then
		return C_HURT
	elseif frac >= 0.3 then
		return C_SEVERE
	end
	return C_CRIT
end

local function organColor(h)
	if h >= 95 then
		return Color3.fromRGB(240, 220, 220)
	elseif h >= 60 then
		return C_HURT
	elseif h >= 30 then
		return C_SEVERE
	elseif h > 0 then
		return C_CRIT
	end
	return Color3.new(0, 0, 0)
end

local function label(parent, text, size, pos, sz, align, color)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.GothamMedium
	t.TextSize = size
	t.TextColor3 = color or Color3.fromRGB(230, 230, 230)
	t.TextXAlignment = align or Enum.TextXAlignment.Left
	t.TextYAlignment = Enum.TextYAlignment.Top
	t.Position = pos
	t.Size = sz
	t.Text = text
	t.Parent = parent
	return t
end

function AnatomyUI.Init(ctx)
	local panel = Instance.new("Frame")
	panel.Name = "AnatomyPanel"
	panel.AnchorPoint = Vector2.new(0.5, 1)
	panel.Position = UDim2.new(0.5, 0, 1, -12)
	panel.Size = UDim2.fromOffset(360, 150)
	panel.BackgroundColor3 = Color3.fromRGB(14, 14, 18)
	panel.BackgroundTransparency = 0.25
	panel.BorderSizePixel = 0
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = panel
	panel.Parent = ctx.Gui
	ui.Panel = panel

	-- silhouette
	local body = Instance.new("Frame")
	body.BackgroundTransparency = 1
	body.Position = UDim2.fromOffset(8, 8)
	body.Size = UDim2.fromOffset(84, 134)
	body.Parent = panel
	local cx, cy = 42, 58 -- pixel position of the pelvis centre
	for _, def in ipairs(Anatomy.Parts) do
		local f = Instance.new("Frame")
		f.Name = def.Name
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromOffset(cx + def.Center.X * K, cy - def.Center.Y * K)
		f.Size = UDim2.fromOffset(math.max(3, def.Size.X * K - 1), math.max(3, def.Size.Y * K - 1))
		f.BackgroundColor3 = C_OK
		f.BorderSizePixel = 0
		local st = Instance.new("UIStroke")
		st.Thickness = 1
		st.Color = Color3.new(0, 0, 0)
		st.Transparency = 0.5
		st.Parent = f
		f.Parent = body
		ui.Segments[def.Segment] = ui.Segments[def.Segment] or {}
		table.insert(ui.Segments[def.Segment], { Frame = f, Stroke = st })
	end
	for _, o in ipairs(Anatomy.Organs) do
		local pdef = Anatomy.PartByName[o.Part]
		local p = pdef.Center + o.Offset
		local d = math.max(5, math.floor(o.Radius * 2 * K * 0.8))
		local f = Instance.new("Frame")
		f.Name = o.Name
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromOffset(cx + p.X * K, cy - p.Y * K)
		f.Size = UDim2.fromOffset(d, d)
		f.BackgroundColor3 = organColor(100)
		f.BorderSizePixel = 0
		f.ZIndex = 3
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0.5, 0)
		c.Parent = f
		local st = Instance.new("UIStroke")
		st.Thickness = 1
		st.Color = Color3.fromRGB(60, 0, 0)
		st.Parent = f
		f.Parent = body
		ui.Organs[o.Name] = f
	end
	label(body, "L", 10, UDim2.fromOffset(0, 0), UDim2.fromOffset(10, 10), nil, Color3.fromRGB(150, 150, 150))
	label(body, "R", 10, UDim2.fromOffset(76, 0), UDim2.fromOffset(10, 10), nil, Color3.fromRGB(150, 150, 150))

	-- blood meter
	local meter = Instance.new("Frame")
	meter.Position = UDim2.fromOffset(102, 22)
	meter.Size = UDim2.fromOffset(16, 100)
	meter.BackgroundColor3 = Color3.fromRGB(40, 20, 22)
	meter.BorderSizePixel = 0
	meter.Parent = panel
	local fill = Instance.new("Frame")
	fill.AnchorPoint = Vector2.new(0, 1)
	fill.Position = UDim2.fromScale(0, 1)
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(170, 14, 22)
	fill.BorderSizePixel = 0
	fill.Parent = meter
	for _, mark in ipairs({ { Config.Blood.Incapacitated, Color3.fromRGB(255, 200, 60) }, { Config.Blood.Lethal, Color3.new(1, 1, 1) } }) do
		local m = Instance.new("Frame")
		m.AnchorPoint = Vector2.new(0, 0.5)
		m.Position = UDim2.fromScale(0, 1 - mark[1])
		m.Size = UDim2.new(1, 4, 0, 2)
		m.BackgroundColor3 = mark[2]
		m.BorderSizePixel = 0
		m.ZIndex = 2
		m.Parent = meter
	end
	ui.BloodFill = fill
	label(panel, "BLOOD", 9, UDim2.fromOffset(96, 8), UDim2.fromOffset(30, 12), Enum.TextXAlignment.Center, Color3.fromRGB(200, 120, 120))
	ui.BloodText = label(panel, "5.0 L", 11, UDim2.fromOffset(94, 124), UDim2.fromOffset(34, 12), Enum.TextXAlignment.Center)
	ui.RateText = label(panel, "", 10, UDim2.fromOffset(90, 136), UDim2.fromOffset(42, 12), Enum.TextXAlignment.Center, C_BLEED)

	-- text column
	ui.State = label(panel, "", 13, UDim2.fromOffset(138, 8), UDim2.fromOffset(214, 16))
	ui.State.Font = Enum.Font.GothamBold
	ui.Injuries = label(panel, "", 11, UDim2.fromOffset(138, 28), UDim2.fromOffset(214, 92))
	ui.Injuries.TextWrapped = true
	ui.Injuries.RichText = true
	local legend = label(panel, "", 10, UDim2.fromOffset(138, 128), UDim2.fromOffset(214, 14))
	legend.RichText = true
	legend.Text = '<font color="#96a896">■</font> ok  <font color="#e2c850">■</font> hurt  <font color="#eb8228">■</font> severe  <font color="#d72828">■</font> critical  <font color="#ff1e1e">□</font> bleeding  × lost'

	ctx.Remotes.AnatomyUpdate.OnClientEvent:Connect(function(snap)
		if typeof(snap) == "table" then
			snapshot = snap
			AnatomyUI.Render(ctx)
		end
	end)
end

function AnatomyUI.OnNewFighter(ctx, model)
	snapshot = nil
end

local function injuryLines(snap)
	local lines = {}
	if snap.Pending then
		table.insert(lines, '<font color="#ff4040"><b>' .. snap.Pending .. " - dying</b></font>")
	end
	if snap.Death then
		table.insert(lines, '<font color="#ff4040"><b>Dead: ' .. snap.Death .. "</b></font>")
	end
	local organs = {}
	for _, o in ipairs(Anatomy.Organs) do
		local h = snap.Org[o.Name]
		if h and h < 100 then
			table.insert(organs, { h, string.format('<font color="#ff8080">%s %d%%</font>', o.Label, h) })
		end
	end
	table.sort(organs, function(a, b)
		return a[1] < b[1]
	end)
	for _, o in ipairs(organs) do
		table.insert(lines, o[2])
	end
	local segs = {}
	for name, rec in pairs(snap.Seg) do
		local def = Anatomy.Segments[name]
		if rec.l then
			table.insert(segs, { -1, def.Label .. " lost" })
		elseif rec.s then
			table.insert(segs, { 0, def.Label .. " severed" })
		elseif rec.i < 85 then
			table.insert(segs, { rec.i, string.format("%s %d%%%s", def.Label, rec.i, rec.f and "" or " (useless)") })
		end
	end
	table.sort(segs, function(a, b)
		return a[1] < b[1]
	end)
	for _, s in ipairs(segs) do
		table.insert(lines, s[2])
	end
	if not snap.Sword and not snap.Death then
		table.insert(lines, '<font color="#ffb050">Disarmed</font>')
	end
	local out = {}
	for i = 1, math.min(6, #lines) do
		out[i] = lines[i]
	end
	if #lines == 0 then
		return '<font color="#96a896">No injuries</font>'
	end
	return table.concat(out, "\n")
end

function AnatomyUI.Render(ctx)
	local snap = snapshot
	if not snap then
		return
	end
	for segName, frames in pairs(ui.Segments) do
		local rec = snap.Seg[segName]
		if rec then
			for _, fr in ipairs(frames) do
				local partLost = rec.l or (rec.s and fr.Frame.Name:sub(-1) == "D")
				if partLost then
					fr.Frame.BackgroundTransparency = 0.85
					fr.Frame.BackgroundColor3 = C_LOST
					fr.Stroke.Color = Color3.fromRGB(180, 40, 40)
					fr.Stroke.Transparency = 0
				else
					fr.Frame.BackgroundTransparency = 0
					fr.Frame.BackgroundColor3 = rec.s and C_CRIT or integrityColor(rec.i / 100)
					local bleeding = rec.b > 1
					fr.Stroke.Color = bleeding and C_BLEED or Color3.new(0, 0, 0)
					fr.Stroke.Thickness = bleeding and 2 or 1
					fr.Stroke.Transparency = bleeding and 0 or 0.5
				end
			end
		end
	end
	for name, f in pairs(ui.Organs) do
		local h = snap.Org[name] or 100
		f.BackgroundColor3 = organColor(h)
		f.Visible = true
	end
	local frac = math.clamp(snap.Blood / snap.BloodMax, 0, 1)
	ui.BloodFill.Size = UDim2.fromScale(1, frac)
	ui.BloodFill.BackgroundColor3 = frac > Config.Blood.WeakAt and Color3.fromRGB(170, 14, 22)
		or (frac > Config.Blood.Incapacitated and Color3.fromRGB(200, 60, 30) or Color3.fromRGB(110, 10, 14))
	ui.BloodText.Text = string.format("%.1f L", snap.Blood / 1000)
	ui.RateText.Text = snap.Rate > 0.5 and string.format("-%d ml/s", math.floor(snap.Rate + 0.5)) or ""
	local state = snap.Death and "Dead" or snap.State
	local extra = ""
	if snap.Inc and not snap.Death then
		extra = "  (incapacitated)"
	elseif snap.Legs and snap.Legs < Config.Movement.KneelLegSupport and snap.Legs > 0 and not snap.Death then
		extra = "  (kneeling)"
	end
	ui.State.Text = tostring(state) .. extra
	ui.State.TextColor3 = (state == "Dead" or snap.Inc) and C_CRIT or Color3.fromRGB(235, 235, 235)
	ui.Injuries.Text = injuryLines(snap)
end

local pulse = 0
function AnatomyUI.Update(ctx, dt)
	-- pulse bleeding outlines so active bleeding reads at a glance
	pulse += dt
	if not snapshot then
		return
	end
	local a = 0.5 + 0.5 * math.sin(pulse * 8)
	for segName, frames in pairs(ui.Segments) do
		local rec = snapshot.Seg[segName]
		if rec and rec.b > 1 and not rec.l then
			for _, fr in ipairs(frames) do
				fr.Stroke.Transparency = a * 0.6
			end
		end
	end
end

return AnatomyUI
]]></ProtectedString>
