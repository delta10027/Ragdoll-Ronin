			<Item class="Folder" referent="RBXCE673383FDB6459B8CC40B10B670BB00">
				<Properties>
					<Color3 name="IconTint">
						<R>0</R>
						<G>0</G>
						<B>0</B>
					</Color3>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">Modules</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				</Properties>
				<Item class="ModuleScript" referent="RBX7E889D6016D640259BB9E07D8BC5305F">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- Small math helpers shared by server modules.
local Util = {}

function Util.isFinite(x)
	return typeof(x) == "number" and x == x and x ~= math.huge and x ~= -math.huge
end

function Util.flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

function Util.unit(v, fallback)
	local m = v.Magnitude
	if m < 1e-6 then
		return fallback or Vector3.zero
	end
	return v / m
end

function Util.smoothstep(t)
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

-- Wrap an angle difference into [-pi, pi]
function Util.angleDelta(from, to)
	return (to - from + math.pi) % (2 * math.pi) - math.pi
end

function Util.approachAngle(cur, target, maxStep)
	local d = Util.angleDelta(cur, target)
	if math.abs(d) <= maxStep then
		return target
	end
	return cur + math.sign(d) * maxStep
end

-- Yaw (rotation about +Y) of a CFrame's look vector, matching CFrame.Angles(0, yaw, 0)
function Util.yawOf(cf)
	local look = cf.LookVector
	return math.atan2(-look.X, -look.Z)
end

function Util.closestPointOnSegment(p, a, b)
	local ab = b - a
	local len2 = ab:Dot(ab)
	if len2 < 1e-9 then
		return a
	end
	local t = math.clamp((p - a):Dot(ab) / len2, 0, 1)
	return a + ab * t
end

-- Angle between the rotations of two CFrames (radians)
function Util.rotationDelta(a, b)
	local _, angle = (a.Rotation:Inverse() * b.Rotation):ToAxisAngle()
	return math.abs(angle)
end

-- Rotate unit vector `cur` toward unit vector `target` by at most maxAngle radians
function Util.rotateToward(cur, target, maxAngle)
	local d = math.clamp(cur:Dot(target), -1, 1)
	local angle = math.acos(d)
	if angle <= maxAngle or angle < 1e-4 then
		return target
	end
	local axis = cur:Cross(target)
	if axis.Magnitude < 1e-4 then
		-- opposite vectors: pick any perpendicular axis
		axis = cur:Cross(Vector3.yAxis)
		if axis.Magnitude < 1e-4 then
			axis = cur:Cross(Vector3.xAxis)
		end
	end
	return CFrame.fromAxisAngle(axis.Unit, maxAngle):VectorToWorldSpace(cur)
end

-- Remove the component of v along unit axis n and normalise; fallback if degenerate
function Util.perpendicular(v, n, fallback)
	local p = v - n * v:Dot(n)
	if p.Magnitude < 1e-4 then
		return fallback
	end
	return p.Unit
end

return Util
]]></ProtectedString>
						<string name="ScriptGuid">{A87A7547-F599-4DF4-A130-CA2844C555C4}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">Util</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXA0A80D14A92444D4B825C44CB90CE695">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[
	Registry: owns the set of live fighters and the part -> fighter lookup used by hit detection.
	A part is mapped only while it is attached to a living body; severed limbs are unmapped.
]]
local Registry = {}

Registry.ById = {}
Registry.ByPlayer = {}
Registry.PartToFighter = {}
Registry.NextId = 0

local debrisFolder
function Registry.DebrisFolder()
	if not debrisFolder or not debrisFolder.Parent then
		debrisFolder = workspace:FindFirstChild("RR_Debris") or Instance.new("Folder")
		debrisFolder.Name = "RR_Debris"
		debrisFolder.Parent = workspace
	end
	return debrisFolder
end

function Registry.NewId()
	Registry.NextId += 1
	return Registry.NextId
end

function Registry.Add(f)
	Registry.ById[f.Id] = f
	if f.Player then
		Registry.ByPlayer[f.Player] = f
	end
	for _, part in pairs(f.Parts) do
		Registry.PartToFighter[part] = f
	end
	if f.Sword then
		Registry.PartToFighter[f.Sword.Blade] = f
		Registry.PartToFighter[f.Sword.ParryZone] = f
	end
end

function Registry.Remove(f)
	Registry.ById[f.Id] = nil
	if f.Player and Registry.ByPlayer[f.Player] == f then
		Registry.ByPlayer[f.Player] = nil
	end
	for part, owner in pairs(Registry.PartToFighter) do
		if owner == f then
			Registry.PartToFighter[part] = nil
		end
	end
end

function Registry.UnmapPart(part)
	Registry.PartToFighter[part] = nil
end

function Registry.FromPart(part)
	return Registry.PartToFighter[part]
end

-- Snapshot array so callers can safely add/remove fighters while iterating
function Registry.List()
	local list = {}
	for _, f in pairs(Registry.ById) do
		table.insert(list, f)
	end
	return list
end

return Registry
]]></ProtectedString>
						<string name="ScriptGuid">{DE800FD5-01DB-4B93-A320-BC7C064C5BFB}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">Registry</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX159A5ED68D1F492490D4E94A8AAA30F9">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[
	Collision groups.
	  RR_Core   torso/pelvis/neck/head. Collide with world and with OTHER fighters' cores (bodies shove).
	            Own core pairs are excluded with NoCollisionConstraints.
	  RR_Limb   arms/legs. Collide with world only: no self-collision, no limb tangling between fighters.
	  RR_Sword  blades never physically collide (contacts are resolved by swept queries instead,
	            which is far more stable than blade-on-blade rigid body contact).
	  RR_Debris severed limbs, dropped swords, corpses: world + other debris only.
	  RR_HitQuery    raycast group for blade sweeps: sees Core, Limb, Sword only (ignores world/debris).
	  RR_GroundQuery raycast group for ground probes and camera: sees the world only.
]]
local PhysicsService = game:GetService("PhysicsService")

local CollisionSetup = {}

local G = {
	Core = "RR_Core",
	Limb = "RR_Limb",
	Sword = "RR_Sword",
	Debris = "RR_Debris",
	HitQuery = "RR_HitQuery",
	GroundQuery = "RR_GroundQuery",
}
CollisionSetup.Groups = G

function CollisionSetup.Init()
	for _, name in pairs(G) do
		if not PhysicsService:IsCollisionGroupRegistered(name) then
			PhysicsService:RegisterCollisionGroup(name)
		end
	end
	local function set(a, b, v)
		PhysicsService:CollisionGroupSetCollidable(a, b, v)
	end
	local D = "Default"
	-- Core
	set(G.Core, D, true)
	set(G.Core, G.Core, true)
	set(G.Core, G.Limb, false)
	set(G.Core, G.Sword, false)
	set(G.Core, G.Debris, false)
	set(G.Core, G.HitQuery, true)
	set(G.Core, G.GroundQuery, false)
	-- Limb
	set(G.Limb, D, true)
	set(G.Limb, G.Limb, false)
	set(G.Limb, G.Sword, false)
	set(G.Limb, G.Debris, false)
	set(G.Limb, G.HitQuery, true)
	set(G.Limb, G.GroundQuery, false)
	-- Sword
	set(G.Sword, D, false)
	set(G.Sword, G.Sword, false)
	set(G.Sword, G.Debris, false)
	set(G.Sword, G.HitQuery, true)
	set(G.Sword, G.GroundQuery, false)
	-- Debris
	set(G.Debris, D, true)
	set(G.Debris, G.Debris, true)
	set(G.Debris, G.HitQuery, false)
	set(G.Debris, G.GroundQuery, false)
	-- Queries
	set(G.HitQuery, D, false)
	set(G.HitQuery, G.HitQuery, false)
	set(G.HitQuery, G.GroundQuery, false)
	set(G.GroundQuery, D, true)
	set(G.GroundQuery, G.GroundQuery, false)
end

return CollisionSetup
]]></ProtectedString>
						<string name="ScriptGuid">{1FF439FF-24C2-43D1-B24B-2A99B2FFCC0C}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">CollisionSetup</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX4E875903052D47A088F96C1EACBC7AD3">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[
	Input: validated per-fighter intent. Written by NetService (players) or DevTools (test dummies).
	The server never receives poses, hits or damage from clients - only this intent.
]]
local Config = require(game:GetService("ReplicatedStorage").RagdollRonin.Config)

local Input = {}

function Input.Neutral()
	return {
		Move = Vector3.zero,
		Yaw = 0,
		AimU = Config.Aim.ReadyU,
		AimV = Config.Aim.ReadyV,
		M1 = false,
		M2 = false,
		Seq = 0,
		LastPacket = 0,
	}
end

function Input.Init(f, yaw)
	f.Input = Input.Neutral()
	f.Input.Yaw = yaw or 0
	f.Input.LastPacket = os.clock()
	f.InputOverride = nil
end

-- Effective intent this frame. Stale player input decays to neutral (keeps facing).
function Input.Get(f)
	if f.InputOverride then
		return f.InputOverride
	end
	local i = f.Input
	if f.Player and os.clock() - i.LastPacket > Config.Network.InputTimeout then
		local n = Input.Neutral()
		n.Yaw = i.Yaw
		return n
	end
	return i
end

return Input
]]></ProtectedString>
						<string name="ScriptGuid">{624A4EE1-97E5-411B-A3CB-B68498425D58}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">Input</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX8CFD9BE0143A4E22BF754173D52863FA">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[
	SwordBuilder: a functional katana.

	Sword frame convention (shared with hit detection and aim):
	  +Y  blade axis, toward the tip
	  +X  cutting-edge direction (the spine faces -X)
	  +Z  flat of the blade
	The grip attachment "GripAtt" on the handle uses this frame, and is welded to the hand's
	"SwordGrip" attachment (the grip joint). The off hand pulls toward "OffGripAtt".
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.RagdollRonin.Config)

local SwordBuilder = {}

local function mk(model, name, size, cf, color, material, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	if shape then
		p.Shape = shape
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.CollisionGroup = "RR_Sword"
	p.CustomPhysicalProperties = PhysicalProperties.new(Config.Physics.SwordDensity, 0.3, 0, 1, 1)
	p.Parent = model
	return p
end

local function weld(a, b)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = a
	return w
end

-- gripCF: world frame (sword convention) where the right hand holds the sword
function SwordBuilder.Build(gripCF)
	local C = Config.Sword
	local model = Instance.new("Model")
	model.Name = "Katana"

	local HL, BL = C.HandleLength, C.BladeLength
	local handleCF = gripCF * CFrame.new(0, -0.25 * HL, 0)
	local handle = mk(model, "Handle", Vector3.new(C.HandleWidth, HL, C.HandleWidth * 0.8), handleCF, Color3.fromRGB(30, 24, 22), Enum.Material.Fabric)
	-- tsuba (cylinder axis is local X, rotate so it lies across the blade axis)
	local guardCF = handleCF * CFrame.new(0, HL / 2 + C.GuardThickness / 2, 0) * CFrame.Angles(0, 0, math.pi / 2)
	local guard = mk(model, "Tsuba", Vector3.new(C.GuardThickness, C.GuardDiameter, C.GuardDiameter), guardCF, Color3.fromRGB(70, 58, 30), Enum.Material.Metal, Enum.PartType.Cylinder)
	local bladeCF = handleCF * CFrame.new(0, HL / 2 + C.GuardThickness + BL / 2, 0)
	local blade = mk(model, "Blade", Vector3.new(C.BladeWidth, BL, C.BladeThickness), bladeCF, Color3.fromRGB(150, 156, 166), Enum.Material.Metal)
	blade.CanQuery = true -- blade-on-blade contacts (clashes) are found by sweeps
	blade:SetAttribute("SwordPart", "Blade")
	-- hamon / cutting edge strip on the +X side so the edge direction is readable
	local edge = mk(model, "Edge", Vector3.new(C.BladeWidth * 0.22, BL * 0.98, C.BladeThickness * 1.08), bladeCF * CFrame.new(C.BladeWidth * 0.4, -BL * 0.01, 0), Color3.fromRGB(235, 238, 242), Enum.Material.SmoothPlastic)
	-- tip wedge (cosmetic)
	local tip = Instance.new("WedgePart")
	tip.Name = "Kissaki"
	local tipLen = C.BladeWidth * 1.6
	tip.Size = Vector3.new(C.BladeThickness, C.BladeWidth, tipLen)
	-- wedge local: -Z is the point, -Y the flat (spine) side. Map wedge Z -> -blade Y, wedge Y -> blade X (edge)
	tip.CFrame = bladeCF * CFrame.new(0, BL / 2 + tipLen / 2, 0)
		* CFrame.fromMatrix(Vector3.zero, Vector3.new(0, 0, -1), Vector3.new(1, 0, 0), Vector3.new(0, -1, 0))
	tip.Color = blade.Color
	tip.Material = Enum.Material.Metal
	tip.CanCollide, tip.CanTouch, tip.CanQuery, tip.CastShadow = false, false, false, false
	tip.CollisionGroup = "RR_Sword"
	tip.CustomPhysicalProperties = PhysicalProperties.new(Config.Physics.SwordDensity, 0.3, 0, 1, 1)
	tip.Parent = model
	-- invisible guard-interception volume, queryable only while the owner is blocking
	local zone = mk(model, "ParryZone", Vector3.new(C.ParryZoneWidth, BL, C.ParryZoneWidth), bladeCF, Color3.new(0.3, 0.6, 1))
	zone.Transparency = 1
	zone.Massless = true
	zone:SetAttribute("SwordPart", "Guard")

	for _, p in ipairs({ guard, blade, edge, tip, zone }) do
		weld(handle, p)
	end

	local gripAtt = Instance.new("Attachment")
	gripAtt.Name = "GripAtt"
	gripAtt.CFrame = CFrame.new(0, 0.25 * HL, 0)
	gripAtt.Parent = handle
	local offGrip = Instance.new("Attachment")
	offGrip.Name = "OffGripAtt"
	offGrip.CFrame = CFrame.new(0, -0.3 * HL, 0)
	offGrip.Parent = handle

	model.PrimaryPart = handle
	return {
		Model = model,
		Handle = handle,
		Blade = blade,
		ParryZone = zone,
		GripAtt = gripAtt,
		OffGripAtt = offGrip,
		TipLocal = Vector3.new(0, BL / 2, 0),
	}
end

-- Blade-local sample points from near the guard to the tip, biased to the edge side
function SwordBuilder.SamplePoints()
	local C = Config.Sword
	local pts = {}
	local y0, y1 = -C.BladeLength / 2 + 0.12, C.BladeLength / 2
	for k = 0, C.SampleCount - 1 do
		local t = k / (C.SampleCount - 1)
		table.insert(pts, Vector3.new(C.BladeWidth * 0.3, y0 + (y1 - y0) * t, 0))
	end
	return pts
end

return SwordBuilder
]]></ProtectedString>
						<string name="ScriptGuid">{AEEE2540-6094-4F94-828C-5ECFBC9B2C91}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">SwordBuilder</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXC46524A28A934B4BBF1EA0BF8D65A62C">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[
	CharacterBuilder: assembles a custom articulated fighter (no Humanoid, no R6/R15 rig).

	Physical structure
	  * 26 parts forming 18 anatomical segments (see Anatomy).
	  * Ball joints: BallSocketConstraint (limits + friction) driven by a TwoAttachment AlignOrientation
	    whose parent-side attachment is rotated to the desired relative pose (procedural motor).
	  * Elbows/knees: HingeConstraint servos.
	  * Limb halves: WeldConstraint seams (cut boundaries).
	  * Pelvis: AlignOrientation (upright/facing), LinearVelocity (planar locomotion), VectorForce (support).
	  * Sword hand: AlignPosition + AlignOrientation toward an attachment on the upper torso that the
	    sword controller moves; the katana is welded to the hand (grip joint).
	All drive strengths start at zero; MotorController sets them every frame from the state machine,
	so exactly one system owns every joint.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.RagdollRonin
local Config = require(Shared.Config)
local Anatomy = require(Shared.Anatomy)
local SwordBuilder = require(script.Parent.SwordBuilder)

local CharacterBuilder = {}

local S = Config.Scale
-- Hand-local frame of the sword grip: sword +Y points out of the fist (hand -Z), edge (+X) along hand -Y
local GRIP_ROT = CFrame.fromMatrix(Vector3.zero, Vector3.new(0, -1, 0), Vector3.new(0, 0, -1))
local AXIS_UP = CFrame.fromMatrix(Vector3.zero, Vector3.new(0, 1, 0), Vector3.new(-1, 0, 0))
local AXIS_DOWN = CFrame.fromMatrix(Vector3.zero, Vector3.new(0, -1, 0), Vector3.new(1, 0, 0))

local function attach(part, name, worldCF)
	local a = Instance.new("Attachment")
	a.Name = name
	a.CFrame = part.CFrame:ToObjectSpace(worldCF)
	a.Parent = part
	return a
end

local function newPart(def, pelvisCF, palette)
	local p = Instance.new("Part")
	p.Name = def.Name
	p.Size = def.Size * S
	p.CFrame = pelvisCF * CFrame.new(def.Center * S)
	p.Color = palette[def.Color] or Anatomy.Colors[def.Color] or Color3.new(0.5, 0.5, 0.5)
	p.Material = (def.Color == "Skin") and Enum.Material.SmoothPlastic or Enum.Material.Fabric
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = true
	p.CanTouch = false
	p.CanQuery = true
	p.CollisionGroup = def.Group == "Core" and "RR_Core" or "RR_Limb"
	local density = def.Group == "Core" and Config.Physics.TorsoDensity or Config.Physics.LimbDensity
	local friction = def.Segment:find("Foot") and Config.Physics.FootFriction or Config.Physics.Friction
	p.CustomPhysicalProperties = PhysicalProperties.new(density, friction, 0, 1, 1)
	p:SetAttribute("Segment", def.Segment)
	return p
end

-- spawnCF: ground position + facing. opts: { Name, GiColor }
function CharacterBuilder.Build(spawnCF, opts)
	opts = opts or {}
	local model = Instance.new("Model")
	model.Name = opts.Name or "Fighter"
	model:SetAttribute("RR_Fighter", true)

	local jointsFolder = Instance.new("Folder")
	jointsFolder.Name = "Joints"
	jointsFolder.Parent = model
	local drivesFolder = Instance.new("Folder")
	drivesFolder.Name = "Drives"
	drivesFolder.Parent = model

	local pelvisCF = spawnCF * CFrame.new(0, Config.Movement.StandHeight + 0.2, 0)
	local palette = { Gi = opts.GiColor }

	-- parts
	local parts = {}
	for _, def in ipairs(Anatomy.Parts) do
		local p = newPart(def, pelvisCF, palette)
		p.Parent = model
		parts[def.Name] = p
	end
	model.PrimaryPart = parts.LowerTorso

	-- face so the head's front is readable
	local face = Instance.new("Decal")
	face.Name = "face"
	face.Texture = "rbxasset://textures/face.png"
	face.Face = Enum.NormalId.Front
	face.Parent = parts.Head

	-- joints
	local joints = {}
	local adjacency = {}
	for name in pairs(parts) do
		adjacency[name] = {}
	end
	for _, jd in ipairs(Anatomy.Joints) do
		local pp, cp = parts[jd.Parent], parts[jd.Child]
		local pivotWorld = pelvisCF * CFrame.new(jd.Pivot * S)
		local rec = {
			Name = jd.Name,
			Def = jd,
			ParentName = jd.Parent,
			ChildName = jd.Child,
			Kind = jd.Type,
			PivotLocal = pp.CFrame:PointToObjectSpace(pivotWorld.Position),
			Instances = {},
			Severed = false,
		}
		if jd.Type == "Weld" then
			local w = Instance.new("WeldConstraint")
			w.Name = jd.Name
			w.Part0 = pp
			w.Part1 = cp
			w.Parent = jointsFolder
			rec.Constraint = w
			table.insert(rec.Instances, w)
		elseif jd.Type == "Ball" then
			local axisCF = pivotWorld * (jd.Axis == "Up" and AXIS_UP or AXIS_DOWN)
			local a0 = attach(pp, "J0_" .. jd.Name, axisCF)
			local a1 = attach(cp, "J1_" .. jd.Name, axisCF)
			local bs = Instance.new("BallSocketConstraint")
			bs.Name = jd.Name
			bs.Attachment0 = a0
			bs.Attachment1 = a1
			bs.LimitsEnabled = true
			bs.UpperAngle = jd.Cone
			bs.TwistLimitsEnabled = true
			bs.TwistLowerAngle = -jd.Twist
			bs.TwistUpperAngle = jd.Twist
			bs.MaxFrictionTorque = Config.Physics.JointFriction
			bs.Restitution = 0
			bs.Parent = jointsFolder
			rec.Constraint = bs
			table.insert(rec.Instances, bs)
			table.insert(rec.Instances, a0)
			table.insert(rec.Instances, a1)
			if jd.DriveClass then
				-- child attachment keeps the rest orientation; the parent-side attachment is the target
				local dc = attach(cp, "D0_" .. jd.Name, pivotWorld)
				local dp = attach(pp, "D1_" .. jd.Name, pivotWorld)
				local ao = Instance.new("AlignOrientation")
				ao.Name = "Drive_" .. jd.Name
				ao.Mode = Enum.OrientationAlignmentMode.TwoAttachment
				ao.Attachment0 = dc
				ao.Attachment1 = dp
				-- internal muscle: equal and opposite torque on the parent, so limbs cannot spin the body
				ao.ReactionTorqueEnabled = true
				ao.RigidityEnabled = false
				ao.MaxTorque = 0
				ao.Responsiveness = Config.Drives.Joint[jd.DriveClass].Responsiveness
				ao.Parent = jointsFolder
				rec.Drive = ao
				rec.TargetAtt = dp
				rec.TargetBase = dp.CFrame
				table.insert(rec.Instances, ao)
				table.insert(rec.Instances, dc)
				table.insert(rec.Instances, dp)
			end
		elseif jd.Type == "Hinge" then
			local a0 = attach(pp, "J0_" .. jd.Name, pivotWorld) -- identity orientation: hinge axis = lateral X
			local a1 = attach(cp, "J1_" .. jd.Name, pivotWorld)
			local h = Instance.new("HingeConstraint")
			h.Name = jd.Name
			h.Attachment0 = a0
			h.Attachment1 = a1
			h.LimitsEnabled = true
			local sign = jd.RotSign * Config.Drives.HingeSign
			local l1, l2 = jd.FlexMin * sign, jd.FlexMax * sign
			h.LowerAngle = math.min(l1, l2)
			h.UpperAngle = math.max(l1, l2)
			h.Restitution = 0
			h.ActuatorType = Enum.ActuatorType.Servo
			h.ServoMaxTorque = 0
			h.AngularSpeed = Config.Drives.Joint[jd.DriveClass].Speed
			h.TargetAngle = 0
			h.Parent = jointsFolder
			rec.Constraint = h
			rec.Sign = sign
			table.insert(rec.Instances, h)
			table.insert(rec.Instances, a0)
			table.insert(rec.Instances, a1)
		end
		joints[jd.Name] = rec
		table.insert(adjacency[jd.Parent], { Part = jd.Child, Joint = jd.Name })
		table.insert(adjacency[jd.Child], { Part = jd.Parent, Joint = jd.Name })
	end

	for _, pair in ipairs(Anatomy.CoreNoCollide) do
		local nc = Instance.new("NoCollisionConstraint")
		nc.Part0 = parts[pair[1]]
		nc.Part1 = parts[pair[2]]
		nc.Parent = jointsFolder
	end

	-- pelvis drives
	local pelvis = parts.LowerTorso
	local root = attach(pelvis, "RootAtt", pelvisCF)
	local upright = Instance.new("AlignOrientation")
	upright.Name = "PelvisUpright"
	upright.Mode = Enum.OrientationAlignmentMode.OneAttachment
	upright.Attachment0 = root
	upright.CFrame = pelvisCF.Rotation
	upright.ReactionTorqueEnabled = false
	upright.MaxTorque = 0
	upright.Responsiveness = Config.Drives.PelvisResponsiveness
	upright.Parent = drivesFolder

	local move = Instance.new("LinearVelocity")
	move.Name = "Locomotion"
	move.Attachment0 = root
	move.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	move.PrimaryTangentAxis = Vector3.xAxis
	move.SecondaryTangentAxis = Vector3.zAxis
	move.RelativeTo = Enum.ActuatorRelativeTo.World
	move.PlaneVelocity = Vector2.zero
	move.MaxForce = 0
	move.Parent = drivesFolder

	local support = Instance.new("VectorForce")
	support.Name = "Support"
	support.Attachment0 = root
	support.RelativeTo = Enum.ActuatorRelativeTo.World
	support.ApplyAtCenterOfMass = true
	support.Force = Vector3.zero
	support.Parent = drivesFolder

	-- sword hand drives + katana
	local hand = parts.RightHand
	local ut = parts.UpperTorso
	local gripWorld = hand.CFrame * CFrame.new(0, -0.05 * S, 0) * GRIP_ROT
	local handGrip = attach(hand, "SwordGrip", gripWorld)
	local swordTarget = attach(ut, "SwordTarget", gripWorld)

	local handPos = Instance.new("AlignPosition")
	handPos.Name = "HandPosition"
	handPos.Mode = Enum.PositionAlignmentMode.TwoAttachment
	handPos.Attachment0 = handGrip
	handPos.Attachment1 = swordTarget
	-- Reaction forces are essential: the target lives on the torso, so a one-sided force would let
	-- the arm drag the whole body forever (self-propulsion). With reaction it is an internal force.
	handPos.ReactionForceEnabled = true
	-- apply at the grip, not the hand+sword assembly COM (that leaves a large steady-state error)
	handPos.ApplyAtCenterOfMass = false
	handPos.MaxForce = 0
	handPos.Responsiveness = Config.Drives.HandResponsiveness
	handPos.MaxVelocity = Config.Drives.HandMaxVelocity
	handPos.Parent = drivesFolder

	local handOri = Instance.new("AlignOrientation")
	handOri.Name = "HandOrientation"
	handOri.Mode = Enum.OrientationAlignmentMode.TwoAttachment
	handOri.Attachment0 = handGrip
	handOri.Attachment1 = swordTarget
	handOri.ReactionTorqueEnabled = true
	handOri.MaxTorque = 0
	handOri.Responsiveness = Config.Drives.HandAngResponsiveness
	handOri.MaxAngularVelocity = Config.Drives.HandMaxAngularVelocity
	handOri.Parent = drivesFolder

	local sword = SwordBuilder.Build(gripWorld)
	sword.Model.Parent = model
	local gripJoint = Instance.new("WeldConstraint")
	gripJoint.Name = "GripJoint"
	gripJoint.Part0 = hand
	gripJoint.Part1 = sword.Handle
	gripJoint.Parent = sword.Model
	sword.GripJoint = gripJoint

	local offHand = parts.LeftHand
	local offGrip = attach(offHand, "OffGrip", offHand.CFrame * CFrame.new(0, -0.05 * S, 0))
	local offPos = Instance.new("AlignPosition")
	offPos.Name = "OffHandPosition"
	offPos.Mode = Enum.PositionAlignmentMode.TwoAttachment
	offPos.Attachment0 = offGrip
	offPos.Attachment1 = sword.OffGripAtt
	offPos.ReactionForceEnabled = true
	offPos.ApplyAtCenterOfMass = false
	offPos.MaxForce = 0
	offPos.Responsiveness = Config.Drives.OffHandResponsiveness
	offPos.Parent = drivesFolder

	local totalMass = 0
	for _, p in pairs(parts) do
		totalMass += p:GetMass()
	end
	for _, p in ipairs(sword.Model:GetChildren()) do
		if p:IsA("BasePart") and not p.Massless then
			totalMass += p:GetMass()
		end
	end

	return {
		Model = model,
		Parts = parts,
		Joints = joints,
		Adjacency = adjacency,
		JointsFolder = jointsFolder,
		Drives = {
			Folder = drivesFolder,
			Root = root,
			Upright = upright,
			Move = move,
			Support = support,
			HandPos = handPos,
			HandOri = handOri,
			SwordTarget = swordTarget,
			HandGrip = handGrip,
			OffPos = offPos,
		},
		Sword = sword,
		TotalMass = totalMass,
		PelvisCF = pelvisCF,
	}
end

-- Server-owned physics: clients never simulate fighter bodies (authority + exploit resistance).
function CharacterBuilder.ClaimOwnership(model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and not d.Anchored then
			pcall(d.SetNetworkOwner, d, nil)
		end
	end
end

return CharacterBuilder
]]></ProtectedString>
						<string name="ScriptGuid">{F2AA237F-72A8-48C1-B95D-50EEA0A04320}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">CharacterBuilder</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXC0D61950EFC0459F9B0D3497E1B22909">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[
	DebugService: development-only diagnostics, off by default.
	Enable at runtime (server): workspace:SetAttribute("RR_Debug", true)
	When enabled: state transitions and hit reports are printed, contact points are marked in the
	world, and the client overlay shows the fighter's debug attributes.
	Key event attributes (LastBlock, LastInjury, SeverResult, DeathReason, RecoveryPhase...) are
	always written on the fighter model because they are cheap and event-driven.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")
local Config = require(ReplicatedStorage.RagdollRonin.Config)

local DebugService = {}

function DebugService.Init()
	if workspace:GetAttribute("RR_Debug") == nil then
		workspace:SetAttribute("RR_Debug", Config.Debug.Enabled)
	end
end

function DebugService.Enabled()
	return workspace:GetAttribute("RR_Debug") == true
end

function DebugService.Log(...)
	if DebugService.Enabled() then
		print("[RR]", ...)
	end
end

function DebugService.Transition(f, from, to, reason)
	if DebugService.Enabled() and Config.Debug.PrintTransitions then
		print(string.format("[RR] %s: %s -> %s (%s)", f.Name, from, to, tostring(reason)))
	end
end

local markerFolder
function DebugService.Marker(position, color, size)
	if not DebugService.Enabled() then
		return
	end
	if not markerFolder or not markerFolder.Parent then
		markerFolder = Instance.new("Folder")
		markerFolder.Name = "RR_DebugMarkers"
		markerFolder.Parent = workspace
	end
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.one * (size or 0.35)
	p.Anchored = true
	p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, false, false, false
	p.Material = Enum.Material.Neon
	p.Color = color or Color3.new(1, 0, 0)
	p.Position = position
	p.Parent = markerFolder
	Debris:AddItem(p, Config.Debug.ContactMarkerLifetime)
end

-- Event attribute (always on)
function DebugService.Attr(f, name, value)
	if f.Model and f.Model.Parent then
		f.Model:SetAttribute(name, value)
	end
end

-- High frequency attributes, throttled and only while debugging
function DebugService.Tick(f)
	if not DebugService.Enabled() then
		return
	end
	local now = os.clock()
	if f.NextDebugAttr and now < f.NextDebugAttr then
		return
	end
	f.NextDebugAttr = now + 1 / Config.Debug.AttributeRate
	local m = f.Model
	m:SetAttribute("SwordSpeed", math.floor((f.Attack and f.Attack.TipSpeed or 0) * 10) / 10)
	m:SetAttribute("Balance", math.floor(f.Balance or 0))
	m:SetAttribute("BleedRate", math.floor((f.Anatomy and f.Anatomy.BleedRate or 0) * 10) / 10)
	m:SetAttribute("Blood", math.floor(f.Anatomy and f.Anatomy.Blood or 0))
	m:SetAttribute("LegSupport", math.floor((f.Caps and f.Caps.LegSupport or 0) * 100) / 100)
	m:SetAttribute("Height", f.Ground and math.floor(f.Ground.Height * 100) / 100 or -1)
end

return DebugService
]]></ProtectedString>
						<string name="ScriptGuid">{B5E8772D-A135-4ADD-A34B-25E813170A04}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">DebugService</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX548112EFA2CA435B8033ACA5B080B2E3">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[
	StateMachine: the single authority over a fighter's state. Every controller reads f.State;
	only this module writes it, and only along transitions allowed by StateDefs.
	Listeners run on every transition (sword controller ends strokes, etc.).
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StateDefs = require(ReplicatedStorage.RagdollRonin.StateDefs)
local DebugService = require(script.Parent.DebugService)

local StateMachine = {}
local listeners = {}

function StateMachine.OnTransition(fn)
	table.insert(listeners, fn)
end

function StateMachine.Init(f)
	f.State = "Idle"
	f.StateTime = os.clock()
	f.StateData = {}
	f.StateHistory = {}
	f.Model:SetAttribute("State", "Idle")
end

function StateMachine.Elapsed(f)
	return os.clock() - f.StateTime
end

function StateMachine.Can(f, to)
	local allowed = StateDefs.Transitions[f.State]
	return allowed ~= nil and allowed[to] == true
end

local function apply(f, to, reason, data)
	local from = f.State
	f.State = to
	f.StateTime = os.clock()
	f.StateData = data or {}
	table.insert(f.StateHistory, string.format("%.2f %s->%s (%s)", os.clock(), from, to, tostring(reason)))
	if #f.StateHistory > 20 then
		table.remove(f.StateHistory, 1)
	end
	if f.Model.Parent then
		f.Model:SetAttribute("State", to)
		f.Model:SetAttribute("StateReason", tostring(reason))
	end
	f.AnatomyDirty = true
	DebugService.Transition(f, from, to, reason)
	for _, fn in ipairs(listeners) do
		fn(f, from, to, reason)
	end
end

-- Returns true if the transition happened
function StateMachine.Set(f, to, reason, data)
	if f.State == to then
		return false
	end
	if not StateMachine.Can(f, to) then
		DebugService.Log("rejected transition", f.Name, f.State, "->", to, reason)
		return false
	end
	apply(f, to, reason, data)
	return true
end

-- Death bypasses the table (any living state may die)
function StateMachine.ForceDead(f, reason)
	if f.State == "Dead" then
		return
	end
	apply(f, "Dead", reason, {})
end

return StateMachine
]]></ProtectedString>
						<string name="ScriptGuid">{F25F292D-E126-48F6-A23D-4EAEFC40F0DD}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">StateMachine</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXE08AE5A1A43C4C63AEB2B0FDAB1290F3">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[
	AnatomyService: the authoritative injury model (server only). No global health value exists.

	Per fighter:
	  Segments[name] = { Integrity 0..100, Bleeding ml/s, Severed, Lost, Functional, Wound }
	  Organs[name]   = { Health 0..100, Destroyed }
	  Blood (ml), BleedRate, Stumps (boundary -> ml/s), Incapacitated, PendingDeath

	Penetration model (ApplyStrike):
	  drive  = power * quality * KindPenetration[kind]
	  resist = segment.Resistance * (0.35 + 0.65 * integrity)      -- damaged tissue resists less
	  drive <= resist      -> "Stopped": the outer structure stops the blade (reduced surface damage)
	  otherwise depth = (drive - resist) * DepthPerPower, capped by segment thickness
	  The wound channel is the segment from the contact point along the blade's relative motion
	  (cuts) or along the blade axis (thrusts). An organ is hit only if that channel geometrically
	  passes within organ radius + blade half width of the organ centre.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.RagdollRonin
local Config = require(Shared.Config)
local Anatomy = require(Shared.Anatomy)
local Util = require(script.Parent.Util)

local AnatomyService = {}
local S = Config.Scale

function AnatomyService.Create(f)
	local A = {
		Segments = {},
		Organs = {},
		Blood = Config.Blood.Max,
		BleedRate = 0,
		Stumps = {},
		Incapacitated = false,
		PendingDeath = nil,
		InjuryLog = {},
	}
	for name in pairs(Anatomy.Segments) do
		A.Segments[name] = { Integrity = 100, Bleeding = 0, Severed = false, Lost = false, Functional = true, Wound = 0 }
	end
	for _, o in ipairs(Anatomy.Organs) do
		A.Organs[o.Name] = { Health = 100, Destroyed = false }
	end
	f.Anatomy = A
	AnatomyService.UpdateCaps(f)
end

local function segFactor(rec)
	if rec.Severed then
		return 0
	end
	return math.clamp(rec.Integrity / 100 + 0.15, 0, 1)
end

-- Derive physical capabilities from injuries. Called after every injury and bleed tick.
function AnatomyService.UpdateCaps(f)
	local A = f.Anatomy
	local seg = A.Segments
	local function leg(side)
		local th, sh, ft = seg[side .. "Thigh"], seg[side .. "Shin"], seg[side .. "Foot"]
		if th.Severed or sh.Severed then
			return 0
		end
		local v = segFactor(th) * 0.5 + segFactor(sh) * 0.35 + (ft.Lost and 0 or segFactor(ft)) * 0.15
		if ft.Lost then
			v *= 0.55
		end
		if not th.Functional or not sh.Functional then
			v *= 0.4
		end
		return v
	end
	local function arm(side)
		local ua, fa, h = seg[side .. "UpperArm"], seg[side .. "Forearm"], seg[side .. "Hand"]
		if ua.Severed or fa.Severed or h.Severed then
			return 0
		end
		local v = segFactor(ua) * 0.4 + segFactor(fa) * 0.35 + segFactor(h) * 0.25
		if not ua.Functional or not fa.Functional then
			v *= 0.3
		end
		return v
	end
	local B = Config.Blood
	local bloodFrac = A.Blood / B.Max
	local bloodStrength = bloodFrac >= B.WeakAt and 1 or (bloodFrac >= B.VeryWeakAt and 0.8 or 0.6)
	local lungsOk = 0
	for _, n in ipairs({ "LungL", "LungR" }) do
		if A.Organs[n].Health > Anatomy.LungFailure.Threshold then
			lungsOk += 1
		end
	end
	local breath = lungsOk == 2 and 1 or (lungsOk == 1 and 0.65 or 0.3)
	local torso = math.min(segFactor(seg.UpperTorso), segFactor(seg.LowerTorso))
	local legL, legR = leg("Left"), leg("Right")
	local legSupport = (legL + legR) / 2
	local swordArm = arm("Right")
	local offArm = arm("Left")
	local hand = seg.RightHand
	local grip = hand.Severed and 0 or (0.3 + 0.7 * segFactor(hand))
	if offArm > 0.3 then
		grip = math.min(1, grip + 0.15) -- two-handed grip steadies the blade
	end

	local caps = f.Caps or {}
	caps.LegLeft, caps.LegRight = legL, legR
	caps.LegSupport = legSupport
	caps.SwordArm = swordArm
	caps.OffArm = offArm
	caps.Grip = grip
	caps.BloodStrength = bloodStrength
	caps.Breath = breath
	caps.Strength = bloodStrength * (0.6 + 0.4 * torso) * math.sqrt(breath)
	caps.Move = math.pow(legSupport, 1.3) * bloodStrength * (0.6 + 0.4 * segFactor(seg.LowerTorso))
	caps.Stability = (0.35 + 0.65 * legSupport) * bloodStrength
	caps.BalanceRegen = breath * bloodStrength * (0.5 + 0.5 * segFactor(seg.LowerTorso))
	caps.BalanceMax = 0.5 + 0.5 * legSupport
	caps.Kneeling = legSupport < Config.Movement.KneelLegSupport
	f.Caps = caps

	local incapacitated = bloodFrac < B.Incapacitated or A.PendingDeath ~= nil or A.Organs.Brain.Health < 60
	A.Incapacitated = incapacitated
end

function AnatomyService.SegmentFactor(f, segName)
	local rec = f.Anatomy.Segments[segName]
	return rec and segFactor(rec) or 0
end

local function damageOrgan(f, organName, amount, results)
	local o = f.Anatomy.Organs[organName]
	if not o or o.Destroyed or amount <= 0 then
		return
	end
	o.Health = math.max(0, o.Health - amount)
	if o.Health <= 0 then
		o.Destroyed = true
	end
	table.insert(results, { Name = organName, Damage = amount, Health = o.Health })
end

local function nearestBoundary(f, segDef, position)
	if not segDef.Boundaries then
		return nil
	end
	local best, bestDist
	for _, bName in ipairs(segDef.Boundaries) do
		local j = f.Joints[bName]
		local parent = j and f.Parts[j.ParentName]
		if j and not j.Severed and parent and f.Parts[j.ChildName] then
			local pivot = parent.CFrame:PointToWorldSpace(j.PivotLocal)
			local d = (pivot - position).Magnitude
			if not bestDist or d < bestDist then
				best, bestDist = bName, d
			end
		end
	end
	return best
end

--[[
	strike = { Segment, Part, Position, Direction (unit relative motion), BladeAxis, Power, Kind, Quality }
	returns { Outcome, Damage, Depth, Organs = {...}, SeverBoundary, EnergyRemaining }
]]
function AnatomyService.ApplyStrike(f, strike)
	local C = Config.Anatomy
	local A = f.Anatomy
	local segDef = Anatomy.Segments[strike.Segment]
	local rec = A.Segments[strike.Segment]
	local result = { Outcome = "None", Damage = 0, Depth = 0, Organs = {}, EnergyRemaining = 1 }
	if not segDef or not rec then
		return result
	end

	local integrity = rec.Integrity / 100
	local resist = segDef.Resistance * (0.35 + 0.65 * integrity)
	local effPower = strike.Power * strike.Quality
	local drive = effPower * C.KindPenetration[strike.Kind]
	local damage = effPower * C.KindDamage[strike.Kind] * C.DamagePerPower
	local depth = 0
	if drive <= resist then
		result.Outcome = "Stopped"
		damage *= C.StoppedDamageMult
	else
		depth = math.min((drive - resist) * C.DepthPerPower * S, segDef.Thickness * S * 1.15)
		result.Outcome = "Wound"
	end
	rec.Integrity = math.max(0, rec.Integrity - damage)
	rec.Wound = math.max(rec.Wound, damage)
	local bleed = damage * C.BleedPerDamage * segDef.BleedFactor * C.KindBleed[strike.Kind]
	if result.Outcome == "Stopped" then
		bleed *= 0.3
	end
	rec.Bleeding += bleed

	-- organ penetration: geometric test of the wound channel against organ spheres
	if depth > 0 then
		local channelDir = (strike.Kind == "Thrust") and strike.BladeAxis or strike.Direction
		local a = strike.Position
		local b = a + channelDir * depth
		for _, o in ipairs(Anatomy.OrgansBySegment[strike.Segment] or {}) do
			local part = f.Parts[o.Part]
			if part then
				local c = part.CFrame:PointToWorldSpace(o.Offset * S)
				local dist = (c - Util.closestPointOnSegment(c, a, b)).Magnitude
				local reach = o.Radius * S + C.BladeHalfWidth
				if dist <= reach then
					local overlap = 1 - 0.5 * dist / reach
					local dmg = C.OrganDamagePerPower * (drive - resist) * overlap * (strike.Kind == "Thrust" and 1.25 or 1)
					damageOrgan(f, o.Name, dmg, result.Organs)
				end
			end
		end
		if #result.Organs > 0 then
			result.Outcome = "Penetrating"
		end
	end

	-- blunt trauma to the skull bruises the brain without penetration
	if strike.Kind == "Blunt" and strike.Segment == "Head" and strike.Power > C.ConcussionPower then
		damageOrgan(f, "Brain", (strike.Power - C.ConcussionPower) * C.ConcussionDamage, result.Organs)
	end

	rec.Functional = not rec.Severed and rec.Integrity > C.DisableBelow

	-- severing: only edge-aligned cuts; existing damage lowers the threshold
	if strike.Kind == "Cut" and segDef.SeverPower then
		local w = C.SeverIntegrityWeight
		local threshold = segDef.SeverPower * ((1 - w) + w * rec.Integrity / 100)
		if effPower >= threshold or rec.Integrity <= 0 then
			result.SeverBoundary = nearestBoundary(f, segDef, strike.Position)
		end
	end

	result.Damage = damage
	result.Depth = depth
	-- energy the blade keeps after this contact (passing through tissue/bone costs momentum)
	local E = C.EnergyRemaining
	result.EnergyRemaining = result.SeverBoundary and E.Severed or (result.Outcome == "Stopped" and E.Stopped or E.Wound)

	local organNames = {}
	for _, o in ipairs(result.Organs) do
		table.insert(organNames, o.Name)
	end
	local entry = string.format("%s %s %s dmg=%.0f depth=%.2f%s", segDef.Label, strike.Kind, result.Outcome, damage, depth,
		#organNames > 0 and (" organs=" .. table.concat(organNames, "+")) or "")
	table.insert(A.InjuryLog, entry)
	if #A.InjuryLog > 12 then
		table.remove(A.InjuryLog, 1)
	end
	result.Summary = entry

	AnatomyService.EvaluateVitals(f)
	AnatomyService.UpdateCaps(f)
	f.AnatomyDirty = true
	return result
end

-- Called by Dismemberment after parts physically separate. distalParts: set of part names.
function AnatomyService.OnSevered(f, boundaryName, distalParts)
	local A = f.Anatomy
	local jd = Anatomy.JointByName[boundaryName]
	for segName, partNames in pairs(Anatomy.SegmentParts) do
		local gone, total = 0, #partNames
		for _, pn in ipairs(partNames) do
			if distalParts[pn] then
				gone += 1
			end
		end
		if gone > 0 then
			local rec = A.Segments[segName]
			rec.Severed = true
			rec.Functional = false
			if gone == total then
				rec.Lost = true
				rec.Bleeding = 0 -- the bleeding is now the stump's
			end
		end
	end
	-- organs inside lost parts are gone
	for _, o in ipairs(Anatomy.Organs) do
		if distalParts[o.Part] then
			local rec = A.Organs[o.Name]
			rec.Health = 0
			rec.Destroyed = true
		end
	end
	-- a cut boundary that crosses major vessels bleeds heavily
	A.Stumps[boundaryName] = { Rate = jd and jd.StumpBleed or 40 }
	table.insert(A.InjuryLog, "SEVERED at " .. ((jd and jd.Label) or boundaryName))
	AnatomyService.EvaluateVitals(f)
	AnatomyService.UpdateCaps(f)
	f.AnatomyDirty = true
end

-- Organ rules that kill after a delay (heart, lungs) schedule PendingDeath and incapacitate.
function AnatomyService.EvaluateVitals(f)
	local A = f.Anatomy
	if A.PendingDeath then
		return
	end
	local now = os.clock()
	for _, o in ipairs(Anatomy.Organs) do
		local rule = o.Lethal
		if rule and rule.Delay > 0 and A.Organs[o.Name].Health <= rule.Threshold then
			A.PendingDeath = { At = now + rule.Delay, Reason = o.Label .. " destroyed" }
			return
		end
	end
	local lf = Anatomy.LungFailure
	if A.Organs.LungL.Health <= lf.Threshold and A.Organs.LungR.Health <= lf.Threshold then
		A.PendingDeath = { At = now + lf.Delay, Reason = "Respiratory failure (both lungs)" }
	end
end

-- Returns a death reason if the fighter must die now, else nil.
function AnatomyService.CheckFatal(f)
	local A = f.Anatomy
	if A.Segments.Neck.Severed or A.Segments.Head.Lost then
		return "Decapitated"
	end
	for _, o in ipairs(Anatomy.Organs) do
		local rule = o.Lethal
		if rule and rule.Delay == 0 and A.Organs[o.Name].Health <= rule.Threshold then
			return o.Label .. " destroyed"
		end
	end
	if A.Segments.Neck.Integrity <= 0 then
		return "Neck destroyed (spinal cord severed)"
	end
	if A.Blood / Config.Blood.Max <= Config.Blood.Lethal then
		return "Blood loss"
	end
	if A.PendingDeath and os.clock() >= A.PendingDeath.At then
		return A.PendingDeath.Reason
	end
	return nil
end

-- Compact snapshot for the owning client's anatomy UI
function AnatomyService.Snapshot(f)
	local A = f.Anatomy
	local segs = {}
	for name, rec in pairs(A.Segments) do
		segs[name] = {
			i = math.floor(rec.Integrity + 0.5),
			b = math.floor(rec.Bleeding * 10) / 10,
			s = rec.Severed,
			l = rec.Lost,
			f = rec.Functional,
		}
	end
	local organs = {}
	for name, rec in pairs(A.Organs) do
		organs[name] = math.floor(rec.Health + 0.5)
	end
	local stumps = 0
	for _ in pairs(A.Stumps) do
		stumps += 1
	end
	return {
		Seg = segs,
		Org = organs,
		Blood = math.floor(A.Blood),
		BloodMax = Config.Blood.Max,
		Rate = math.floor(A.BleedRate * 10) / 10,
		State = f.State,
		Inc = A.Incapacitated,
		Pending = A.PendingDeath and A.PendingDeath.Reason or nil,
		Death = f.DeathReason,
		Legs = math.floor((f.Caps.LegSupport or 0) * 100) / 100,
		Arm = math.floor((f.Caps.SwordArm or 0) * 100) / 100,
		Sword = f.Sword ~= nil,
		Log = { table.unpack(A.InjuryLog, math.max(1, #A.InjuryLog - 3)) },
	}
end

return AnatomyService
]]></ProtectedString>
						<string name="ScriptGuid">{2D8D99FC-EE02-4322-8F70-EBA9CB095D73}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">AnatomyService</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX4845172333C045D0AFF95D05955AA498">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[
	BloodFX: bounded server-side visuals (replicate to everyone).
	  * wound marks welded at contact points (capped per fighter, oldest recycled)
	  * one particle emitter per bleeding source, rate driven by the bleeding model
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.RagdollRonin.Config)

local BloodFX = {}
local BLOOD = Color3.fromRGB(110, 8, 12)

function BloodFX.WoundMark(f, part, position, normal, severity)
	if not part or not part.Parent then
		return
	end
	f.WoundMarks = f.WoundMarks or {}
	if #f.WoundMarks >= Config.Anatomy.MaxWoundMarks then
		local old = table.remove(f.WoundMarks, 1)
		if old then
			old:Destroy()
		end
	end
	local sev = math.clamp(severity, 0, 1)
	local m = Instance.new("Part")
	m.Name = "Wound"
	m.Size = Vector3.new(0.08 + 0.12 * sev, 0.25 + 0.35 * sev, 0.03)
	local n = (normal and normal.Magnitude > 0.5) and normal.Unit or Vector3.yAxis
	m.CFrame = CFrame.lookAt(position, position + n) * CFrame.Angles(0, 0, math.random() * math.pi)
	m.Color = BLOOD
	m.Material = Enum.Material.SmoothPlastic
	m.Massless = true
	m.CanCollide, m.CanQuery, m.CanTouch, m.CastShadow = false, false, false, false
	m.CollisionGroup = "RR_Debris"
	local w = Instance.new("WeldConstraint")
	w.Part0 = part
	w.Part1 = m
	w.Parent = m
	m.Parent = part
	table.insert(f.WoundMarks, m)
	-- a new welded part makes the engine reset the assembly to automatic network ownership on the
	-- next step; Main re-claims server ownership over the following frames
	f.OwnershipDirty = 3
end

local function newEmitter(parent)
	local pe = Instance.new("ParticleEmitter")
	pe.Name = "Blood"
	pe.Texture = "rbxasset://textures/particles/smoke_main.dds"
	pe.Color = ColorSequence.new(BLOOD)
	pe.LightEmission = 0
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.12), NumberSequenceKeypoint.new(1, 0.04) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 0.8) })
	pe.Lifetime = NumberRange.new(0.4, 0.8)
	pe.Speed = NumberRange.new(2, 6)
	pe.SpreadAngle = Vector2.new(35, 35)
	pe.Acceleration = Vector3.new(0, -40, 0)
	pe.Rate = 0
	pe.Parent = parent
	return pe
end

-- key: segment name or "stump:<boundary>"
function BloodFX.Source(f, key, part, worldCF)
	f.BleedSources = f.BleedSources or {}
	local src = f.BleedSources[key]
	if src and src.Emitter.Parent then
		return src
	end
	local count = 0
	for _ in pairs(f.BleedSources) do
		count += 1
	end
	if count >= Config.Anatomy.MaxBleedEmitters then
		return nil
	end
	local att = Instance.new("Attachment")
	att.Name = "BleedAtt"
	att.CFrame = part.CFrame:ToObjectSpace(worldCF)
	att.Parent = part
	src = { Emitter = newEmitter(att), Attachment = att }
	f.BleedSources[key] = src
	return src
end

function BloodFX.Burst(part, position, amount)
	if not part or not part.Parent then
		return
	end
	local att = Instance.new("Attachment")
	att.CFrame = part.CFrame:ToObjectSpace(CFrame.new(position))
	att.Parent = part
	local pe = newEmitter(att)
	pe.Speed = NumberRange.new(6, 14)
	pe:Emit(math.clamp(math.floor(amount), 4, 40))
	game:GetService("Debris"):AddItem(att, 1.5)
end

-- Drive emitter rates from the bleeding model (called from the bleed tick)
function BloodFX.Update(f)
	if not f.BleedSources then
		return
	end
	local A = f.Anatomy
	for key, src in pairs(f.BleedSources) do
		if not src.Emitter.Parent then
			f.BleedSources[key] = nil
		else
			local rate
			local boundary = key:match("^stump:(.+)$")
			if boundary then
				local s = A.Stumps[boundary]
				rate = s and s.Rate or 0
			else
				local rec = A.Segments[key]
				rate = rec and rec.Bleeding or 0
			end
			if f.Dead then
				rate *= 0.3
			end
			src.Emitter.Rate = math.clamp(rate * 0.35, 0, 60)
		end
	end
end

return BloodFX
]]></ProtectedString>
						<string name="ScriptGuid">{EBC247F7-AEDB-490F-97C0-575D77AF157B}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">BloodFX</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX111E9306F9654B07B1B7FCC6D59B8AB4">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[
	Dismemberment: physical separation of body segments.

	Engine reality: Roblox has no supported runtime API for slicing arbitrary meshes/parts along a
	plane at an arbitrary contact point. So the body is authored as modular sub-segments and every
	limb is severable at predefined anatomical boundaries (neck, mid upper arm, elbow, mid forearm,
	wrist, mid thigh, knee, mid shin, ankle). A cut severs the boundary nearest to the contact.

	Severing really detaches the geometry:
	  * the boundary's joint constraint / weld seam and its motor drive are destroyed
	  * every part distal to the boundary (graph walk over intact joints) moves into a debris model,
	    keeping its internal joints as a limp chain, with all motors disabled
	  * parts are unmapped from hit detection, switched to the debris collision group and given a
	    bounded impulse; sword/off-hand drives that depended on the lost parts are removed
	  * stump caps + a bleeding source are added; anatomy and capabilities are updated by the caller
	Debris has a lifetime and a global cap.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.RagdollRonin.Config)
local Registry = require(script.Parent.Registry)
local BloodFX = require(script.Parent.BloodFX)
local DebugService = require(script.Parent.DebugService)
local CharacterBuilder = require(script.Parent.CharacterBuilder)

local Dismemberment = {}
local debrisQueue = {}

function Dismemberment.TrackDebris(model, lifetime)
	table.insert(debrisQueue, model)
	while #debrisQueue > Config.Dismemberment.MaxDebrisModels do
		local old = table.remove(debrisQueue, 1)
		if old and old.Parent then
			old:Destroy()
		end
	end
	task.delay(lifetime, function()
		local i = table.find(debrisQueue, model)
		if i then
			table.remove(debrisQueue, i)
		end
		if model.Parent then
			model:Destroy()
		end
	end)
end

local NON_SOLID = { ParryZone = true, Wound = true, Stump = true }
local function toDebris(part)
	part.CollisionGroup = "RR_Debris"
	part.CanQuery = false
	-- limbs are non-colliding while their owner stands; debris must land on the world
	part.CanCollide = not (part.Massless or NON_SOLID[part.Name])
end

--[[
	Ownership hand-off for debris MUST be deferred. Destroying the joint does not split the physics
	mechanism until the next step; setting auto ownership on a debris part before that applies to
	the whole connected body, letting a nearby client take over simulating a live fighter (found in
	testing: bodies were launched by client-side simulation without the server's drives).
	After the split, debris goes to automatic ownership and the server re-claims the body.
]]
local function connectedToFighter(part)
	for _, p in ipairs(part:GetConnectedParts(true)) do
		if Registry.FromPart(p) then
			return true
		end
	end
	return false
end

local function releaseOwnership(model, f, attempt)
	attempt = attempt or 1
	task.delay(0.25, function()
		if not model.Parent then
			return
		end
		local parts = {}
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") and not d.Anchored then
				if connectedToFighter(d) then
					-- mechanism not split yet (or still linked): keep everything server-owned, retry
					if attempt < 8 then
						releaseOwnership(model, f, attempt + 1)
					end
					return
				end
				table.insert(parts, d)
			end
		end
		for _, d in ipairs(parts) do
			pcall(d.SetNetworkOwnershipAuto, d)
		end
		if f and f.Model.Parent and not f.Removed then
			CharacterBuilder.ClaimOwnership(f.Model)
		end
	end)
end

-- Parts reachable from startPart through intact joints (the cut joint must already be marked)
local function collectDistal(f, startPart)
	local set = { [startPart] = true }
	local stack = { startPart }
	while #stack > 0 do
		local p = table.remove(stack)
		for _, edge in ipairs(f.Adjacency[p] or {}) do
			local j = f.Joints[edge.Joint]
			if j and not j.Severed and not set[edge.Part] and f.Parts[edge.Part] then
				set[edge.Part] = true
				table.insert(stack, edge.Part)
			end
		end
	end
	return set
end

local function stumpCap(part, pivot, axis, diameter)
	local perp = math.abs(axis.Y) < 0.9 and Vector3.yAxis or Vector3.xAxis
	local cap = Instance.new("Part")
	cap.Name = "Stump"
	cap.Shape = Enum.PartType.Cylinder
	cap.Size = Vector3.new(0.05, diameter, diameter)
	cap.CFrame = CFrame.fromMatrix(pivot, axis, perp:Cross(axis).Unit)
	cap.Color = Color3.fromRGB(120, 20, 24)
	cap.Material = Enum.Material.SmoothPlastic
	cap.Massless = true
	cap.CanCollide, cap.CanQuery, cap.CanTouch, cap.CastShadow = false, false, false, false
	cap.CollisionGroup = "RR_Debris"
	local w = Instance.new("WeldConstraint")
	w.Part0 = part
	w.Part1 = cap
	w.Parent = cap
	cap.Parent = part
	return cap
end

local function moveSwordToDebris(f, parentModel)
	local sword = f.Sword
	if not sword then
		return nil
	end
	Registry.UnmapPart(sword.Blade)
	Registry.UnmapPart(sword.ParryZone)
	for _, p in ipairs(sword.Model:GetDescendants()) do
		if p:IsA("BasePart") then
			toDebris(p)
		end
	end
	if f.Drives.OffPos then
		f.Drives.OffPos:Destroy()
		f.Drives.OffPos = nil
	end
	sword.Model.Parent = parentModel
	f.Sword = nil
	f.Model:SetAttribute("HasSword", false)
	return sword
end

local function recomputeMass(f)
	local m = 0
	for _, p in pairs(f.Parts) do
		m += p:GetMass()
	end
	if f.Sword then
		for _, p in ipairs(f.Sword.Model:GetDescendants()) do
			if p:IsA("BasePart") and not p.Massless then
				m += p:GetMass()
			end
		end
	end
	f.TotalMass = m
end

-- Returns the set of distal part names on success, nil if the boundary was already severed.
function Dismemberment.Sever(f, boundaryName, direction, power)
	local j = f.Joints[boundaryName]
	if not j or j.Severed or not f.Parts[j.ChildName] or not f.Parts[j.ParentName] then
		return nil
	end
	local parentPart = f.Parts[j.ParentName]
	local childPart = f.Parts[j.ChildName]
	local pivot = parentPart.CFrame:PointToWorldSpace(j.PivotLocal)
	local axis = childPart.CFrame.UpVector
	local diameter = math.min(childPart.Size.X, childPart.Size.Z) * 0.95

	j.Severed = true
	local distal = collectDistal(f, j.ChildName)

	-- 1. cut the boundary connection
	for _, inst in ipairs(j.Instances) do
		inst:Destroy()
	end
	j.Instances = {}

	-- the container is parented first so severed parts never leave the workspace (leaving and
	-- re-entering resets network ownership of the still-connected mechanism)
	local debrisModel = Instance.new("Model")
	debrisModel.Name = string.format("Severed_%s_%s", f.Name, boundaryName)
	debrisModel.Parent = Registry.DebrisFolder()

	-- 2. joints fully inside the severed piece become a limp, undriven chain
	for name, jj in pairs(f.Joints) do
		if not jj.Severed and distal[jj.ParentName] and distal[jj.ChildName] then
			jj.Severed = true
			jj.Detached = true
			for _, inst in ipairs(jj.Instances) do
				if inst:IsA("AlignOrientation") then
					inst:Destroy()
				elseif inst:IsA("HingeConstraint") then
					inst.ActuatorType = Enum.ActuatorType.None
					inst.Parent = debrisModel
				elseif inst:IsA("Constraint") or inst:IsA("WeldConstraint") then
					inst.Parent = debrisModel
				end
			end
		end
	end

	-- 3. drives that depended on the lost parts
	if distal.RightHand then
		for _, key in ipairs({ "HandPos", "HandOri" }) do
			if f.Drives[key] then
				f.Drives[key]:Destroy()
				f.Drives[key] = nil
			end
		end
		moveSwordToDebris(f, debrisModel)
	end
	if distal.LeftHand and f.Drives.OffPos then
		f.Drives.OffPos:Destroy()
		f.Drives.OffPos = nil
	end

	-- 4. move geometry
	local moved = {}
	for name in pairs(distal) do
		local p = f.Parts[name]
		Registry.UnmapPart(p)
		f.Parts[name] = nil
		f.DetachedParts[name] = p
		toDebris(p)
		p.Parent = debrisModel
		table.insert(moved, p)
	end
	f.OwnershipDirty = 3 -- stump cap welded to the body: re-claim after the engine merges it
	releaseOwnership(debrisModel, f)

	-- 5. stumps + blood
	stumpCap(parentPart, pivot, axis, diameter)
	stumpCap(childPart, pivot, axis, diameter)
	BloodFX.Source(f, "stump:" .. boundaryName, parentPart, CFrame.new(pivot))
	BloodFX.Burst(childPart, pivot, 25)

	-- 6. bounded separation impulse
	local dv = math.min(power * Config.Dismemberment.SeverDVPerPower, Config.Dismemberment.MaxSeverDV)
	local dir = (direction.Unit + Vector3.new(0, 0.3, 0)).Unit
	for _, p in ipairs(moved) do
		if p.AssemblyRootPart == p then
			p:ApplyImpulse(dir * dv * p.AssemblyMass)
		end
	end

	Dismemberment.TrackDebris(debrisModel, Config.Dismemberment.DebrisLifetime)
	recomputeMass(f)
	DebugService.Attr(f, "SeverResult", boundaryName)
	DebugService.Log(f.Name, "severed at", boundaryName)
	return distal
end

-- Lose the sword without losing the hand (crippled grip)
function Dismemberment.DropSword(f, impulse)
	if not f.Sword then
		return
	end
	local sword = f.Sword
	if sword.GripJoint then
		sword.GripJoint:Destroy()
	end
	local holder = Instance.new("Model")
	holder.Name = "DroppedSword_" .. f.Name
	holder.Parent = Registry.DebrisFolder()
	moveSwordToDebris(f, holder)
	f.OwnershipDirty = 3
	releaseOwnership(holder, f)
	if impulse then
		sword.Handle:ApplyImpulse(impulse * sword.Handle.AssemblyMass)
	end
	Dismemberment.TrackDebris(holder, Config.Dismemberment.DebrisLifetime)
	recomputeMass(f)
	DebugService.Attr(f, "SeverResult", "Disarmed")
end

Dismemberment.RecomputeMass = recomputeMass

return Dismemberment
]]></ProtectedString>
						<string name="ScriptGuid">{F31C794B-B2DB-4A77-9B1B-D03C1A23BE96}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">Dismemberment</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXA6E72D2112184BABA49C536FF3BA29D3">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[
	MotorController: the ONLY writer of joint targets and drive strengths.

	Each frame it
	  1. picks a muscle tone for the current state (upright / limp / bracing / ramping recovery / dead)
	  2. computes a procedural pose (stance, gait, kneel, brace, falling) + arm IK toward the sword
	  3. writes joint drive targets/strengths (scaled by segment integrity: injured limbs droop)
	  4. writes pelvis upright torque, planar locomotion and support force
	  5. writes sword-hand / off-hand drives
	Writes are thresholded so unchanged targets do not replicate.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.RagdollRonin
local Config = require(Shared.Config)
local Anatomy = require(Shared.Anatomy)
local StateDefs = require(Shared.StateDefs)
local Util = require(script.Parent.Util)
local AnatomyService = require(script.Parent.AnatomyService)

local MotorController = {}

local S = Config.Scale
local M = Config.Movement
local D = Config.Drives
local rad = math.rad

local TONE = {
	Idle = { Body = 1, Arm = 1, Upright = 1, Support = 1, Move = 1 },
	Moving = { Body = 1, Arm = 1, Upright = 1, Support = 1, Move = 1 },
	Attacking = { Body = 1, Arm = 1, Upright = 1, Support = 1, Move = M.AttackSpeedMult },
	Blocking = { Body = 1, Arm = 1, Upright = 1, Support = 1, Move = M.BlockSpeedMult },
	Staggered = { Body = 0.8, Arm = 0.45, Upright = 0.75, Support = 1, Move = M.StaggerSpeedMult, Accel = M.StaggerAcceleration },
	OffBalance = { Body = 0.85, Arm = 0.7, Upright = 0.45, Support = 1, Move = M.OffBalanceSpeedMult, Accel = M.StaggerAcceleration },
	Falling = { Body = 0.06, Arm = 0.05, Upright = 0, Support = 0, Move = 0 },
	GroundedRecovery = { Body = 0.45, Arm = 0.4, Upright = 0, Support = 0, Move = 0 },
	Recovering = { Body = 1, Arm = 0.6, Upright = 1, Support = 1, Move = 0 }, -- scaled by the attempt ramp
	SeverelyInjured = { Body = 0.15, Arm = 0.12, Upright = 0, Support = 0, Move = 0 },
	Dead = { Body = 0, Arm = 0, Upright = 0, Support = 0, Move = 0 },
}
MotorController.Tone = TONE

local ARM_CLASS = { Shoulder = true, Elbow = true, Wrist = true }
local LIMB_PART = {}
for _, def in ipairs(Anatomy.Parts) do
	if def.Group == "Limb" then
		LIMB_PART[def.Name] = true
	end
end
local SHOULDER = { Right = Vector3.new(1.2, 0.5, 0) * S, Left = Vector3.new(-1.2, 0.5, 0) * S }
local POLE = { Right = Vector3.new(0.4, -0.6, 0.7).Unit, Left = Vector3.new(-0.4, -0.6, 0.7).Unit }
local L1 = 1.05 * S -- shoulder pivot -> elbow pivot
local L2 = 1.425 * S -- elbow pivot -> palm grip
local L_FOREARM = 1.15 * S -- elbow pivot -> wrist pivot
-- hand-local frame of the sword grip (must match CharacterBuilder)
local GRIP_LOCAL = CFrame.new(0, -0.05 * S, 0) * CFrame.fromMatrix(Vector3.zero, Vector3.new(0, -1, 0), Vector3.new(0, 0, -1))
local GRIP_LOCAL_INV = GRIP_LOCAL:Inverse()
local WRIST_IN_HAND = Vector3.new(0, 0.225 * S, 0)

------------------------------------------------------------------ thresholded writes
local function cacheOf(f, inst)
	local c = f.DriveCache[inst]
	if not c then
		c = {}
		f.DriveCache[inst] = c
	end
	return c
end

local function setNum(f, inst, prop, value, eps)
	local c = cacheOf(f, inst)
	local old = c[prop]
	if old == nil or math.abs(old - value) > eps or (value == 0 and old ~= 0) then
		inst[prop] = value
		c[prop] = value
	end
end

local function setCF(f, inst, prop, cf, posEps, angEps)
	local c = cacheOf(f, inst)
	local old = c[prop]
	if old == nil or (old.Position - cf.Position).Magnitude > posEps or Util.rotationDelta(old, cf) > angEps then
		inst[prop] = cf
		c[prop] = cf
	end
end

local function setVec(f, inst, prop, v, eps)
	local c = cacheOf(f, inst)
	local old = c[prop]
	if old == nil or (old - v).Magnitude > eps then
		inst[prop] = v
		c[prop] = v
	end
end

------------------------------------------------------------------ IK
-- Two-bone arm IK in upper-torso space. Returns upper-arm rotation (rest frame: limb along -Y,
-- elbow flexion about +X toward -Z) and elbow flex angle.
local function solveArm(side, target, poleDir, l2)
	l2 = l2 or L2
	local shoulder = SHOULDER[side]
	local toT = target - shoulder
	local d = math.clamp(toT.Magnitude, 0.25 * (L1 + l2), (L1 + l2) * 0.999)
	local n = Util.unit(toT, Vector3.new(0, -1, 0))
	local cosA = math.clamp((L1 * L1 + d * d - l2 * l2) / (2 * L1 * d), -1, 1)
	local cosE = math.clamp((L1 * L1 + l2 * l2 - d * d) / (2 * L1 * l2), -1, 1)
	local flex = math.pi - math.acos(cosE)
	local fallbackPole = Util.perpendicular(POLE[side], n, Util.perpendicular(Vector3.new(0, 0, 1), n, Vector3.xAxis))
	local pole = poleDir and Util.perpendicular(poleDir, n, fallbackPole) or fallbackPole
	local sinA = math.sqrt(1 - cosA * cosA)
	local u = n * cosA + pole * sinA -- upper arm direction
	local elbow = shoulder + u * L1
	local fore = Util.unit(target - elbow, n)
	local Y = -u
	local Z = -Util.perpendicular(fore, u, -pole) -- forearm deviates toward local -Z
	local X = Y:Cross(Z)
	return CFrame.fromMatrix(Vector3.zero, X, Y, Z), flex
end

------------------------------------------------------------------ poses
local function hangArms(pose, side)
	local s = side == "Right" and 1 or -1
	pose[side .. "Shoulder"] = CFrame.Angles(rad(8), 0, s * rad(6))
	pose[side .. "Elbow"] = rad(20)
end

-- Gait is driven by the COMMANDED velocity: driving it from actual velocity lets a shove start
-- the stepping cycle, which then kicks the ground and sustains itself.
local function standLegs(f, dt, pose)
	local pelvis = f.Parts.LowerTorso
	local vel = f.CommandedVelocity or Vector3.zero
	local speed = vel.Magnitude
	local frac = math.clamp(speed / M.WalkSpeed, 0, 1)
	local g = f.Gait
	if speed > 0.6 then
		g.Phase = (g.Phase + dt * speed / M.StrideLength * 2 * math.pi) % (2 * math.pi)
	end
	local lv = pelvis.CFrame:VectorToObjectSpace(vel)
	local m = Util.unit(Vector3.new(lv.X, 0, lv.Z), Vector3.new(0, 0, -1))
	local axis = Vector3.new(-m.Z, 0, m.X) -- rotating the leg about this swings it toward m
	local fwd = -m.Z
	for _, side in ipairs({ "Left", "Right" }) do
		local ph = g.Phase + (side == "Right" and math.pi or 0)
		local swing = M.GaitHipAmplitude * frac * math.sin(ph)
		local knee = M.StanceKneeBend + M.GaitKneeAmplitude * frac * math.max(0, math.cos(ph))
		local stancePitch = (side == "Left" and rad(10) or rad(-8)) * (1 - frac)
		local splay = (side == "Right" and 1 or -1) * rad(4)
		local thighPitch = knee * 0.5 + stancePitch
		pose[side .. "Hip"] = CFrame.fromAxisAngle(axis, swing) * CFrame.Angles(thighPitch, 0, splay)
		pose[side .. "Knee"] = knee
		pose[side .. "Ankle"] = CFrame.Angles(knee - thighPitch - swing * fwd, 0, -splay)
	end
end

local function kneelLegs(f, pose)
	local front = (f.Caps.LegLeft >= f.Caps.LegRight) and "Left" or "Right"
	local back = front == "Left" and "Right" or "Left"
	pose[front .. "Hip"] = CFrame.Angles(rad(70), 0, 0)
	pose[front .. "Knee"] = rad(85)
	pose[front .. "Ankle"] = CFrame.Angles(rad(15), 0, 0)
	pose[back .. "Hip"] = CFrame.Angles(rad(-10), 0, 0)
	pose[back .. "Knee"] = rad(100)
	pose[back .. "Ankle"] = CFrame.Angles(rad(40), 0, 0)
end

local function bracePose(pose, faceDown)
	for _, side in ipairs({ "Left", "Right" }) do
		local s = side == "Right" and 1 or -1
		if faceDown then
			pose[side .. "Hip"] = CFrame.Angles(rad(80), 0, s * rad(6))
			pose[side .. "Knee"] = rad(100)
			pose[side .. "Ankle"] = CFrame.Angles(rad(20), 0, 0)
			pose[side .. "Shoulder"] = CFrame.Angles(rad(80), 0, s * rad(10))
			pose[side .. "Elbow"] = rad(40)
		else
			pose[side .. "Hip"] = CFrame.Angles(rad(70), 0, s * rad(8))
			pose[side .. "Knee"] = rad(95)
			pose[side .. "Ankle"] = CFrame.Angles(rad(25), 0, 0)
			pose[side .. "Shoulder"] = CFrame.Angles(rad(-30), 0, s * rad(25))
			pose[side .. "Elbow"] = rad(30)
		end
	end
	pose.Waist = CFrame.Angles(faceDown and rad(-10) or rad(-35), 0, 0)
	pose.NeckBase = CFrame.Angles(faceDown and rad(20) or rad(-20), 0, 0)
	pose.NeckHead = CFrame.identity
end

local function fallingPose(pose)
	for _, side in ipairs({ "Left", "Right" }) do
		pose[side .. "Hip"] = CFrame.Angles(rad(20), 0, 0)
		pose[side .. "Knee"] = rad(30)
		pose[side .. "Elbow"] = rad(30)
	end
end

local function twoHanded(f)
	return f.Sword ~= nil and f.Drives.OffPos ~= nil and f.Caps.OffArm > 0.2 and StateDefs.Upright[f.State] == true
end

local function armPose(f, pose)
	if f.Sword and f.Joints.RightShoulder and not f.Joints.RightShoulder.Severed and f.SwordTargetCF then
		-- orientation-aware IK: aim the wrist, and bend the elbow toward where the forearm would
		-- naturally be for the requested hand orientation, so the wrist needs minimal bending
		local handCF = f.SwordTargetCF * GRIP_LOCAL_INV
		local wrist = handCF:PointToWorldSpace(WRIST_IN_HAND)
		local idealElbow = wrist + handCF.UpVector * L_FOREARM
		local rot, flex = solveArm("Right", wrist, idealElbow - SHOULDER.Right, L_FOREARM)
		pose.RightShoulder = rot
		pose.RightElbow = flex
	elseif not pose.RightShoulder then
		hangArms(pose, "Right")
	end
	if twoHanded(f) then
		local offTarget = (f.SwordTargetCF * CFrame.new(0, -0.55 * Config.Sword.HandleLength, 0)).Position
		local rot, flex = solveArm("Left", offTarget)
		pose.LeftShoulder = rot
		pose.LeftElbow = flex
	elseif not pose.LeftShoulder then
		hangArms(pose, "Left")
	end
end

local function blendPose(a, b, t)
	local out = {}
	for k, va in pairs(a) do
		local vb = b[k]
		if vb == nil then
			out[k] = va
		elseif typeof(va) == "CFrame" then
			out[k] = va:Lerp(vb, t)
		else
			out[k] = va + (vb - va) * t
		end
	end
	for k, vb in pairs(b) do
		if out[k] == nil then
			out[k] = vb
		end
	end
	return out
end

local function uprightPose(f, dt)
	local pose = {}
	local st = f.State
	local aim = f.Aim
	local torsoYaw = 0
	local lean = rad(6)
	if st == "Attacking" then
		torsoYaw = -aim.U * 0.45
		lean += rad(6) * math.clamp(0.5 - aim.V * 0.5, 0, 1)
	elseif st == "Blocking" then
		torsoYaw = -aim.U * 0.25
	end
	pose.Waist = CFrame.Angles(0, torsoYaw, 0) * CFrame.Angles(-lean, 0, 0)
	pose.NeckBase = CFrame.Angles(0, -torsoYaw * 0.5, 0)
	pose.NeckHead = CFrame.Angles(lean * 0.5, -torsoYaw * 0.5, 0)
	if f.Caps.Kneeling then
		kneelLegs(f, pose)
	else
		standLegs(f, dt, pose)
	end
	armPose(f, pose)
	return pose
end

function MotorController.ComputePose(f, dt)
	local st = f.State
	if StateDefs.Upright[st] then
		return uprightPose(f, dt)
	end
	local pose = {}
	if st == "Falling" or st == "Dead" then
		fallingPose(pose)
	elseif st == "GroundedRecovery" or st == "SeverelyInjured" then
		bracePose(pose, f.StateData.FaceDown == true)
	elseif st == "Recovering" then
		local brace = {}
		bracePose(brace, f.StateData.FaceDown == true)
		local stand = uprightPose(f, dt)
		pose = blendPose(brace, stand, Util.smoothstep(f.StateData.R or 0))
	end
	armPose(f, pose)
	return pose
end

------------------------------------------------------------------ apply
function MotorController.Apply(f, dt, inp)
	local st = f.State
	local tone = TONE[st] or TONE.Idle
	local caps = f.Caps
	local r = (st == "Recovering") and (f.StateData.R or 0) or 1
	local strength = 0.55 + 0.45 * caps.Strength
	local bodyTone = tone.Body * strength * (st == "Recovering" and (0.5 + 0.5 * r) or 1)
	local armTone = tone.Arm * strength

	-- 0. limbs only touch the world while the fighter is actually down. When upright, the support
	--    spring carries the body and limbs are posed procedurally; driven limbs pressing into the
	--    ground get a ground reaction that kicks or even catapults the body (found in testing).
	--    On the ground they collide normally so falls, bracing and push-ups are physical.
	local limbsCollide = not StateDefs.Upright[st] and not (st == "Recovering" and r > 0.5)
	if f.LimbsCollide ~= limbsCollide then
		f.LimbsCollide = limbsCollide
		for name, part in pairs(f.Parts) do
			if LIMB_PART[name] then
				part.CanCollide = limbsCollide
			end
		end
	end

	-- 1. joints
	local pose = MotorController.ComputePose(f, dt)
	for name, j in pairs(f.Joints) do
		if not j.Severed then
			local cls = j.Def.DriveClass and D.Joint[j.Def.DriveClass]
			if cls then
				local segF = AnatomyService.SegmentFactor(f, Anatomy.PartByName[j.ChildName].Segment)
				local t = (ARM_CLASS[j.Def.DriveClass] and armTone or bodyTone) * (0.25 + 0.75 * segF)
				if name == "RightWrist" and f.Sword then
					t = 0 -- the sword drive owns the sword hand's orientation
				end
				if j.Kind == "Ball" and j.Drive then
					setNum(f, j.Drive, "MaxTorque", cls.Torque * t, cls.Torque * 0.02)
					setCF(f, j.TargetAtt, "CFrame", j.TargetBase * (pose[name] or CFrame.identity), 0.01, D.TargetAngleEpsilon)
				elseif j.Kind == "Hinge" then
					setNum(f, j.Constraint, "ServoMaxTorque", cls.Torque * t, cls.Torque * 0.02)
					local flex = math.clamp(pose[name] or 0, rad(j.Def.FlexMin), rad(j.Def.FlexMax))
					setNum(f, j.Constraint, "TargetAngle", math.deg(flex) * j.Sign, 0.5)
				end
			end
		end
	end

	-- 2. pelvis: facing + upright
	local Dr = f.Drives
	local pelvis = f.Parts.LowerTorso
	if StateDefs.Upright[st] then
		local rate = (st == "Attacking" or st == "Blocking") and M.AttackTurnRate or M.TurnRate
		f.FacingYaw = Util.approachAngle(f.FacingYaw, inp.Yaw, rate * dt)
	elseif st == "Recovering" then
		f.FacingYaw = f.StateData.Yaw or f.FacingYaw
	end
	local leanCF = CFrame.identity
	if st == "OffBalance" and f.StateData.PushDir then
		local axis = Vector3.yAxis:Cross(f.StateData.PushDir)
		if axis.Magnitude > 1e-3 then
			leanCF = CFrame.fromAxisAngle(axis.Unit, rad(14))
		end
	end
	setCF(f, Dr.Upright, "CFrame", leanCF * CFrame.Angles(0, f.FacingYaw, 0), 1, rad(0.5))
	local uprightTone = tone.Upright * (st == "Recovering" and r * Config.Recovery.UprightTorqueScale or 1)
	setNum(f, Dr.Upright, "MaxTorque", D.PelvisTorquePerMass * f.TotalMass * uprightTone * caps.Stability, 5)

	-- 3. locomotion
	local moveDir = StateDefs.Upright[st] and inp.Move or Vector3.zero
	local speed = M.WalkSpeed * tone.Move * caps.Move * (caps.Kneeling and M.KneelSpeedMult or 1)
	local vel = moveDir * speed
	f.CommandedVelocity = vel
	setVec(f, Dr.Move, "PlaneVelocity", Vector2.new(vel.X, vel.Z), 0.05)
	local authority = (tone.Support > 0 and f.Grounded) and r or 0
	setNum(f, Dr.Move, "MaxForce", f.TotalMass * (tone.Accel or M.Acceleration) * authority, 1)

	-- 4. support (spring-damper toward stand/kneel height, scaled by the recovery ramp)
	local force = 0
	if tone.Support > 0 and f.Ground then
		local target = f.TargetHeight
		if st == "Recovering" then
			target = (f.StateData.StartHeight or target) + (target - (f.StateData.StartHeight or target)) * Util.smoothstep(r)
		end
		local g = workspace.Gravity
		local vy = pelvis.AssemblyLinearVelocity.Y
		local acc = g + M.SupportStiffness * (target - f.Ground.Height) - M.SupportDamping * vy
		acc = math.clamp(acc, 0, g * M.MaxSupportAccel)
		force = f.TotalMass * acc * tone.Support * r
	end
	setVec(f, Dr.Support, "Force", Vector3.new(0, force, 0), f.TotalMass * 2)

	-- 5. hands
	if Dr.HandPos and Dr.HandOri then
		local k = 0
		if f.Sword and f.SwordTargetCF then
			k = armTone * caps.SwordArm * caps.Grip
			if os.clock() < f.Attack.RecoilUntil then
				k *= Config.Combat.RecoilHandScale
			end
			setCF(f, Dr.SwordTarget, "CFrame", f.SwordTargetCF, 0.004, rad(0.3))
		end
		setNum(f, Dr.HandPos, "MaxForce", D.HandForce * k, D.HandForce * 0.01)
		setNum(f, Dr.HandOri, "MaxTorque", D.HandTorque * k, D.HandTorque * 0.01)
		setNum(f, Dr.HandPos, "MaxVelocity", D.HandMaxVelocity * (0.6 + 0.4 * caps.SwordArm), 0.5)
	end
	if Dr.OffPos then
		setNum(f, Dr.OffPos, "MaxForce", twoHanded(f) and D.OffHandForce * armTone * caps.OffArm or 0, 5)
	end
end

MotorController.SolveArm = solveArm
return MotorController
]]></ProtectedString>
						<string name="ScriptGuid">{F6D7B5D5-356E-4787-94FD-EDE2CA1311EB}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">MotorController</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX9551B2E857A34E4894C25209718F1E60">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[
	BalanceController: decides WHAT the body is doing (state logic). MotorController decides HOW.

	  * ground probe (world-only raycast) -> height above ground, grounded flag
	  * balance meter: drained by impacts, regenerates while upright (limited by injuries)
	  * physical fall detection: excessive pelvis tilt or losing the ground
	  * input-driven Idle/Moving/Attacking/Blocking selection
	  * the recovery sequence:
	      Falling          limp; wait until the body settles (or a timeout)
	      GroundedRecovery brace pose chosen from posture (face-down push-up / face-up sit-up);
	                       wait BraceTime (Space shortens it), with back-off after failed attempts
	      Recovering       upright torque and support force ramp from 0 -> 1 over RampTime / legs,
	                       pose blends brace -> stand. Success needs the pelvis upright, near target
	                       height and slow for StableTime. Timeout -> back to GroundedRecovery.
	      SeverelyInjured  no leg support or incapacitated: braced on the ground, no standing
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.RagdollRonin
local Config = require(Shared.Config)
local StateDefs = require(Shared.StateDefs)
local Util = require(script.Parent.Util)
local StateMachine = require(script.Parent.StateMachine)
local DebugService = require(script.Parent.DebugService)

local BalanceController = {}

local M = Config.Movement
local B = Config.Balance
local R = Config.Recovery

local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Exclude
groundParams.CollisionGroup = "RR_GroundQuery"
groundParams.IgnoreWater = true

function BalanceController.Init(f, yaw)
	f.Balance = B.Max
	f.FacingYaw = yaw or 0
	f.TiltTimer = 0
	f.AirTimer = 0
	f.Gait = { Phase = 0 }
	f.Recovery = { Attempts = 0 }
	f.RecoverRequested = false
	f.TargetHeight = M.StandHeight
	f.Grounded = true
end

local function probe(f)
	local pelvis = f.Parts.LowerTorso
	local origin = pelvis.Position
	local res = workspace:Raycast(origin, Vector3.new(0, -(M.StandHeight + M.GroundProbeExtra), 0), groundParams)
	if res then
		f.Ground = { Height = origin.Y - res.Position.Y, Normal = res.Normal, Point = res.Position }
	else
		f.Ground = nil
	end
	f.Grounded = f.Ground ~= nil and f.Ground.Height < f.TargetHeight + M.GroundedTolerance
	f.UpDot = pelvis.CFrame.UpVector.Y
end

local function retryDelay(f)
	local d = R.BraceTime + R.RetryBaseDelay * f.Recovery.Attempts
	return math.min(d, R.BraceTime + R.RetryMaxDelay)
end

local function canEverStand(f)
	return f.Caps.LegSupport >= R.MinLegSupport and not f.Anatomy.Incapacitated
end

local function headingYaw(f)
	-- heading the body is lying along: projected look vector, or up vector when lying flat
	local cf = f.Parts.LowerTorso.CFrame
	local v = Util.flat(cf.LookVector)
	if v.Magnitude < 0.3 then
		v = Util.flat(-cf.UpVector)
		if cf.LookVector.Y > 0 then
			v = -v
		end
	end
	if v.Magnitude < 1e-3 then
		return f.FacingYaw
	end
	v = v.Unit
	return math.atan2(-v.X, -v.Z)
end

------------------------------------------------------------------ reactions (called by CombatResolver)
function BalanceController.KnockDown(f, pushDir, power, reason)
	if f.Dead then
		return
	end
	if StateMachine.Set(f, "Falling", reason or "Knockdown") then
		local dv = math.min(power, 12) / 12 * Config.Combat.KnockdownDV
		local dir = (Util.unit(Util.flat(pushDir), Vector3.zAxis) + Vector3.new(0, 0.15, 0)).Unit
		for _, name in ipairs({ "UpperTorso", "Head" }) do
			local p = f.Parts[name]
			if p then
				p:ApplyImpulse(dir * dv * p.AssemblyMass)
			end
		end
	end
end

function BalanceController.Stagger(f, duration, pushDir, reason)
	if f.Dead or not StateDefs.Upright[f.State] then
		return false
	end
	if f.State == "Staggered" then
		f.StateData.Until = math.max(f.StateData.Until, os.clock() + duration)
		return true
	end
	return StateMachine.Set(f, "Staggered", reason or "Stagger", { Until = os.clock() + duration, PushDir = pushDir and Util.unit(Util.flat(pushDir)) })
end

function BalanceController.OffBalance(f, pushDir, reason)
	if f.Dead or not StateDefs.Upright[f.State] or f.State == "Staggered" then
		return false
	end
	return StateMachine.Set(f, "OffBalance", reason or "Balance", { PushDir = pushDir and Util.unit(Util.flat(pushDir)) })
end

function BalanceController.RequestRecover(f)
	f.RecoverRequested = true
end

------------------------------------------------------------------ per-frame update
function BalanceController.Update(f, dt, inp)
	probe(f)
	local st = f.State
	if st == "Dead" then
		return
	end
	local now = os.clock()
	local pelvis = f.Parts.LowerTorso
	local caps = f.Caps

	-- stance height (rate limited: a sudden drop of the spring target makes the body dive)
	local crouch = (st == "Attacking" or st == "Blocking") and 0.97 or 1
	local desiredHeight = M.StandHeight * (caps.Kneeling and M.KneelHeightFactor or 1) * crouch
	local maxStep = M.HeightChangeRate * dt
	f.TargetHeight += math.clamp(desiredHeight - f.TargetHeight, -maxStep, maxStep)

	-- incapacitation or loss of both legs takes the fighter down from any active state
	if (StateDefs.Upright[st] or st == "Recovering") and not canEverStand(f) then
		StateMachine.Set(f, "Falling", f.Anatomy.Incapacitated and "Incapacitated" or "No leg support")
		return
	end

	-- suddenly losing a leg's support (severed / shattered) topples a standing fighter
	local lastLegs = f.LastLegSupport or caps.LegSupport
	f.LastLegSupport = caps.LegSupport
	if StateDefs.Upright[st] and lastLegs - caps.LegSupport >= 0.3 then
		StateMachine.Set(f, "Falling", "Lost a leg")
		return
	end

	if StateDefs.Upright[st] then
		-- physical loss of balance
		if f.UpDot < math.cos(B.TiltFallAngle) then
			f.TiltTimer += dt
		else
			f.TiltTimer = 0
		end
		if f.Grounded then
			f.AirTimer = 0
		else
			f.AirTimer += dt
		end
		if f.TiltTimer > B.TiltFallTime then
			StateMachine.Set(f, "Falling", "Tipped over")
			return
		end
		if f.AirTimer > B.UngroundedFallTime then
			StateMachine.Set(f, "Falling", "Lost footing")
			return
		end
		if f.Balance <= 0 then
			StateMachine.Set(f, "Falling", "Balance depleted")
			return
		end

		-- regeneration (slower while reeling)
		local regen = B.Regen * caps.BalanceRegen * ((st == "Staggered" or st == "OffBalance") and 0.5 or 1)
		f.Balance = math.min(B.Max * caps.BalanceMax, f.Balance + regen * dt)

		if st == "Staggered" then
			if now >= (f.StateData.Until or 0) then
				if f.Balance < B.OffBalanceThreshold then
					StateMachine.Set(f, "OffBalance", "Still reeling", { PushDir = f.StateData.PushDir })
				else
					StateMachine.Set(f, "Idle", "Stagger ended")
				end
			end
			return
		elseif st == "OffBalance" then
			if f.Balance >= B.RecoverAt * caps.BalanceMax then
				StateMachine.Set(f, "Idle", "Regained balance")
			end
			return
		end

		-- controllable states follow intent
		local canSword = f.Sword ~= nil and caps.SwordArm > 0.05
		local want
		if inp.M2 and canSword then
			want = "Blocking"
		elseif canSword and (inp.M1 or f.Attack.FollowThrough) then
			want = "Attacking"
		elseif inp.Move.Magnitude > 0.1 then
			want = "Moving"
		else
			want = "Idle"
		end
		if want ~= st then
			StateMachine.Set(f, want, "Input")
		end
		return
	end

	if st == "Falling" then
		local t = StateMachine.Elapsed(f)
		local speed = pelvis.AssemblyLinearVelocity.Magnitude
		if (t > R.MinFallTime and speed < R.SettleSpeed) or t > R.MaxFallTime then
			local faceDown = pelvis.CFrame.LookVector.Y < -0.3
			if canEverStand(f) then
				StateMachine.Set(f, "GroundedRecovery", "Settled", { Wait = retryDelay(f), FaceDown = faceDown })
			else
				StateMachine.Set(f, "SeverelyInjured", f.Anatomy.Incapacitated and "Incapacitated" or "Cannot stand", { FaceDown = faceDown })
			end
		end
	elseif st == "GroundedRecovery" then
		f.StateData.FaceDown = pelvis.CFrame.LookVector.Y < -0.3
		if not canEverStand(f) then
			StateMachine.Set(f, "SeverelyInjured", "Cannot stand", { FaceDown = f.StateData.FaceDown })
			return
		end
		local t = StateMachine.Elapsed(f)
		local manual = f.RecoverRequested and t > R.ManualMinGroundTime
		if t >= (f.StateData.Wait or R.BraceTime) or manual then
			f.Recovery.Attempts += 1
			StateMachine.Set(f, "Recovering", manual and "Player attempt" or "Auto attempt", {
				R = 0,
				FaceDown = f.StateData.FaceDown,
				StartHeight = f.Ground and f.Ground.Height or (M.StandHeight * 0.3),
				Yaw = headingYaw(f),
				Stable = 0,
				Attempt = f.Recovery.Attempts,
			})
		end
		f.RecoverRequested = false
	elseif st == "Recovering" then
		local d = f.StateData
		local t = StateMachine.Elapsed(f)
		local rampTime = R.RampTime / math.max(0.4, caps.LegSupport) / math.max(0.5, caps.Strength)
		d.R = math.clamp(t / rampTime, 0, 1)
		local upright = f.UpDot >= R.SuccessUpDot
		local high = f.Ground ~= nil and f.Ground.Height >= f.TargetHeight * R.SuccessHeightFrac
		local slow = pelvis.AssemblyLinearVelocity.Magnitude < R.MaxSuccessSpeed
		if d.R >= 0.6 and upright and high and slow then
			d.Stable += dt
		else
			d.Stable = 0
		end
		if d.Stable >= R.StableTime then
			f.Recovery.Attempts = 0
			f.Balance = math.max(f.Balance, R.RestoredBalance * caps.BalanceMax)
			f.TiltTimer, f.AirTimer = 0, 0
			StateMachine.Set(f, "Idle", "Recovered")
		elseif t > R.Timeout then
			StateMachine.Set(f, "GroundedRecovery", "Attempt failed", { Wait = retryDelay(f), FaceDown = pelvis.CFrame.LookVector.Y < -0.3 })
		end
	elseif st == "SeverelyInjured" then
		f.StateData.FaceDown = pelvis.CFrame.LookVector.Y < -0.3
		if canEverStand(f) and StateMachine.Elapsed(f) > R.BraceTime then
			StateMachine.Set(f, "GroundedRecovery", "Able to try again", { Wait = retryDelay(f), FaceDown = f.StateData.FaceDown })
		end
	end

	local phase = st == "Recovering" and string.format("attempt %d r=%.1f", f.StateData.Attempt or 0, f.StateData.R or 0)
		or (StateDefs.Ground[st] and st or "-")
	if phase ~= f.LastRecoveryPhase then
		f.LastRecoveryPhase = phase
		DebugService.Attr(f, "RecoveryPhase", phase)
	end
end

return BalanceController
]]></ProtectedString>
						<string name="ScriptGuid">{B9BFFC65-337F-4C60-A16F-42195C547B6A}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">BalanceController</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX13E27A2E69054506BEBD3059162A10A9">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[
	SwordController: turns the player's 2D combat cursor into a physically driven sword.

	Input mapping (all in upper-torso space, so the torso twist carries the sword):
	  cursor (u, v) on a unit disk, u = right, v = up.
	  ATTACK pose: grip moves across the body with the cursor; the blade points outward from the
	    body toward the cursor and forward, so sweeping the cursor sweeps the tip through an arc.
	    Centre of the disk = blade straight ahead and arms extended (thrust).
	  GUARD pose: the cursor picks the threatened side; the blade is laid ACROSS that line
	    (perpendicular to the radial direction) with the edge facing the threat.
	  EDGE: while swinging, the cutting edge turns to face the direction the cursor moves (rate
	    limited), so a deliberate stroke leads with the edge and a sloppy one hits with the flat.

	Smoothing/inertia: the server's controller cursor chases the client cursor with a gain, an
	acceleration limit and a hard speed cap (Config.Aim). The resulting target is applied through
	force/torque-limited AlignPosition/AlignOrientation with velocity caps, so the blade has mass,
	lag and limits; the client can never teleport it.

	Stroke tracking (post-physics): a stroke opens when the tip's speed relative to the pelvis
	exceeds StrokeStartSpeed while attacking, and closes when it slows, reverses sharply, the
	button is released (after a short follow-through) or the state changes. Hit deduplication and
	commitment are per stroke, so a resting blade can never deal damage.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.RagdollRonin
local Config = require(Shared.Config)
local Util = require(script.Parent.Util)
local DebugService = require(script.Parent.DebugService)

local SwordController = {}

local S = Config.Scale
local A = Config.Aim
local C = Config.Combat
local SHOULDER_R = Vector3.new(1.2, 0.5, 0) * S
local REACH_MAX = (1.05 + 1.425) * S * 0.98
local REACH_MIN = 0.55 * S
local DEFAULT_EDGE = Vector3.new(0, -1, 0)

function SwordController.Init(f)
	f.Aim = { U = A.ReadyU, V = A.ReadyV, VU = 0, VV = 0, Edge = DEFAULT_EDGE, Guard = 0 }
	f.Attack = {
		Phase = "Ready",
		Stroke = nil,
		StrokeCount = 0,
		RecoilUntil = 0,
		ReleaseTime = nil,
		FollowThrough = false,
		PrevBladeCF = nil,
		TipSpeed = 0,
		SegmentHitTimes = {},
	}
	f.Block = { Active = false, StartTime = 0 }
	f.Model:SetAttribute("AttackPhase", "Ready")
	f.Model:SetAttribute("HasSword", true)
end

------------------------------------------------------------------ pose mapping
local function attackPose(u, v)
	local r2 = math.min(1, u * u + v * v)
	local pos = Vector3.new(u * A.GripSpreadX, A.GripBaseY + v * A.GripSpreadY, -(A.GripDepth + A.ThrustDepth * (1 - r2))) * S
	local dir = Vector3.new(u * A.BladeOutward, v * A.BladeOutward + A.BladeLift, -1).Unit
	return pos, dir
end

local function guardPose(u, v)
	local r = math.sqrt(u * u + v * v)
	local ru, rv = 0, 1
	if r >= 0.2 then
		ru, rv = u / r, v / r
	end
	-- blade lies across the threatened line; prefer tip-up orientations
	local du, dv = -rv, ru
	if dv < -0.15 then
		du, dv = -du, -dv
	end
	local dir = Vector3.new(du, dv, -0.35).Unit
	local reach = math.clamp(r, 0.35, 1)
	local blockPoint = Vector3.new(ru * A.GuardRadius * reach, A.GuardBaseY + rv * A.GuardRadius * reach, -A.GuardDepth) * S
	local pos = blockPoint - dir * (Config.Sword.BladeLength * 0.45 + Config.Sword.HandleLength * 0.3)
	local edge = Vector3.new(ru, rv, -0.2)
	return pos, dir, edge
end

local function clampReach(pos)
	local d = pos - SHOULDER_R
	local m = d.Magnitude
	if m > REACH_MAX then
		return SHOULDER_R + d / m * REACH_MAX
	elseif m < REACH_MIN and m > 1e-4 then
		return SHOULDER_R + d / m * REACH_MIN
	end
	return pos
end

------------------------------------------------------------------ pre-physics: aim -> target
function SwordController.UpdateAim(f, dt, inp)
	local now = os.clock()
	local st = f.State
	local swordOK = f.Sword ~= nil and f.Caps.SwordArm > 0.05
	local mode = "Ready"
	if swordOK and st == "Attacking" then
		mode = "Attack"
	elseif swordOK and st == "Blocking" then
		mode = "Guard"
	end

	-- guard bookkeeping (parry timing starts when the guard is raised)
	local blocking = mode == "Guard"
	if blocking ~= f.Block.Active then
		f.Block.Active = blocking
		if blocking then
			f.Block.StartTime = now
		end
		if f.Sword then
			f.Sword.ParryZone.CanQuery = blocking
		end
	end

	-- release / follow-through
	local atk = f.Attack
	if inp.M1 and swordOK then
		atk.ReleaseTime = nil
	elseif atk.ReleaseTime == nil then
		atk.ReleaseTime = now
	end
	atk.FollowThrough = atk.Stroke ~= nil and atk.ReleaseTime ~= nil and (now - atk.ReleaseTime) < C.FollowThroughTime

	-- controller cursor chases the requested cursor with inertia and a speed cap
	local aim = f.Aim
	local tu, tv = A.ReadyU, A.ReadyV
	if mode ~= "Ready" then
		tu, tv = inp.AimU, inp.AimV
	end
	local du, dv = (tu - aim.U) * A.Gain, (tv - aim.V) * A.Gain
	local m = math.sqrt(du * du + dv * dv)
	if m > A.MaxSpeed then
		du, dv = du / m * A.MaxSpeed, dv / m * A.MaxSpeed
	end
	local k = math.min(1, A.Accel * dt)
	aim.VU += (du - aim.VU) * k
	aim.VV += (dv - aim.VV) * k
	aim.U += aim.VU * dt
	aim.V += aim.VV * dt
	local r = math.sqrt(aim.U * aim.U + aim.V * aim.V)
	if r > 1 then
		aim.U, aim.V = aim.U / r, aim.V / r
	end

	aim.Guard += ((blocking and 1 or 0) - aim.Guard) * math.min(1, A.GuardBlendRate * dt)

	local apos, adir = attackPose(aim.U, aim.V)
	local gpos, gdir, gedge = guardPose(aim.U, aim.V)
	local g = aim.Guard
	local pos = apos:Lerp(gpos, g)
	local dir = Util.unit(adir:Lerp(gdir, g), adir)

	local spd = math.sqrt(aim.VU * aim.VU + aim.VV * aim.VV)
	local wantEdge
	if mode == "Attack" and spd > A.EdgeMinSpeed then
		wantEdge = Vector3.new(aim.VU, aim.VV, 0) / spd
	elseif mode == "Ready" then
		wantEdge = DEFAULT_EDGE
	else
		wantEdge = aim.Edge
	end
	-- Guard: the edge's facing does not matter for a block, so choose the roll the sword arm can
	-- actually reach (the forearm runs opposite the edge in the grip): edge pointing away from
	-- the shoulder. Hysteresis prevents flip-flopping.
	if g > 0.5 then
		local toShoulder = Util.unit(SHOULDER_R - pos, Vector3.zAxis)
		local ge = Util.perpendicular(gedge.Unit, dir, gedge.Unit)
		local keep = aim.GuardFlip and -ge or ge
		local other = -keep
		if (-other):Dot(toShoulder) > (-keep):Dot(toShoulder) + 0.3 then
			aim.GuardFlip = not aim.GuardFlip
		end
		gedge = aim.GuardFlip and -ge or ge
	else
		aim.GuardFlip = false
	end
	wantEdge = Util.unit(wantEdge:Lerp(gedge.Unit, g), wantEdge)
	wantEdge = Util.perpendicular(wantEdge, dir, Util.perpendicular(DEFAULT_EDGE, dir, Vector3.xAxis))
	local cur = Util.perpendicular(aim.Edge, dir, wantEdge)
	aim.Edge = Util.rotateToward(cur, wantEdge, A.EdgeTurnRate * dt)
	local X = Util.perpendicular(aim.Edge, dir, wantEdge)

	pos = clampReach(pos)
	f.SwordTargetCF = CFrame.fromMatrix(pos, X, dir, X:Cross(dir))
end

------------------------------------------------------------------ strokes
function SwordController.StartStroke(f, dir)
	local atk = f.Attack
	atk.StrokeCount += 1
	atk.Stroke = {
		Id = atk.StrokeCount,
		Dir = dir,
		Start = os.clock(),
		Distance = 0,
		LowTime = 0,
		PeakSpeed = 0,
		Hits = {},
		GuardPassed = {},
		EnergyMult = 1,
	}
	return atk.Stroke
end

function SwordController.EndStroke(f, reason)
	local atk = f.Attack
	if atk and atk.Stroke then
		atk.Stroke = nil
		atk.LastStrokeEnd = reason
	end
end

function SwordController.Recoil(f, duration)
	SwordController.EndStroke(f, "Recoil")
	f.Attack.RecoilUntil = math.max(f.Attack.RecoilUntil, os.clock() + duration)
end

local function setPhase(f, phase)
	if f.Attack.Phase ~= phase then
		f.Attack.Phase = phase
		f.Model:SetAttribute("AttackPhase", phase)
	end
end

-- Post-physics. Returns sweep info {PrevCF, CF, Dt, Stroke} if the blade may strike this frame.
function SwordController.Track(f, dt, inp)
	local atk = f.Attack
	if not f.Sword then
		atk.Stroke = nil
		atk.PrevBladeCF = nil
		setPhase(f, "Unarmed")
		return nil
	end
	local cf = f.Sword.Blade.CFrame
	local prev = atk.PrevBladeCF
	atk.PrevBladeCF = cf
	if not prev or dt <= 0 then
		return nil
	end
	local tipLocal = f.Sword.TipLocal
	local tipVel = (cf:PointToWorldSpace(tipLocal) - prev:PointToWorldSpace(tipLocal)) / dt
	local rel = tipVel - f.Parts.LowerTorso.AssemblyLinearVelocity
	local speed = rel.Magnitude
	atk.TipSpeed = speed
	local now = os.clock()

	local canStrike = f.State == "Attacking" and now >= atk.RecoilUntil and f.Caps.SwordArm > 0.05
	local s = atk.Stroke
	if s then
		if not canStrike then
			SwordController.EndStroke(f, "State")
			s = nil
		else
			local dirNow = speed > 1e-3 and rel / speed or s.Dir
			s.Distance += speed * dt
			s.PeakSpeed = math.max(s.PeakSpeed, speed)
			s.LowTime = speed < C.StrokeEndSpeed and s.LowTime + dt or 0
			if s.LowTime > C.StrokeEndHold then
				SwordController.EndStroke(f, "Slowed")
				s = nil
			elseif speed > C.StrokeStartSpeed and dirNow:Dot(s.Dir) < C.ReversalDot then
				SwordController.EndStroke(f, "Reversal")
				s = SwordController.StartStroke(f, dirNow)
			elseif not inp.M1 and atk.ReleaseTime and now - atk.ReleaseTime > C.FollowThroughTime then
				SwordController.EndStroke(f, "Released")
				s = nil
			else
				s.Dir = Util.unit(s.Dir * 0.8 + dirNow * 0.2, s.Dir)
			end
		end
	elseif canStrike and inp.M1 and speed > C.StrokeStartSpeed then
		s = SwordController.StartStroke(f, rel / speed)
	end

	if now < atk.RecoilUntil then
		setPhase(f, "Recoil")
	elseif s then
		setPhase(f, "Swing")
	elseif f.State == "Attacking" then
		setPhase(f, "Guiding")
	elseif f.State == "Blocking" then
		setPhase(f, "Guard")
	else
		setPhase(f, "Ready")
	end

	if s then
		return { PrevCF = prev, CF = cf, Dt = dt, Stroke = s }
	end
	return nil
end

-- State listener: anything that takes the fighter out of Attacking ends the stroke
function SwordController.OnTransition(f, from, to)
	if to ~= "Attacking" then
		SwordController.EndStroke(f, "State:" .. to)
	end
	if to ~= "Blocking" and f.Block and f.Block.Active then
		f.Block.Active = false
		if f.Sword then
			f.Sword.ParryZone.CanQuery = false
		end
	end
end

return SwordController
]]></ProtectedString>
						<string name="ScriptGuid">{68525119-EF28-4EE8-9E12-78BA8DD78898}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">SwordController</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX2E74C18669B04A44B8E1A5A9210FBC29">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[
	HitDetection: continuous (swept) blade collision. Touched events are not used.

	Between the blade's pose after the previous physics step and its pose now, the motion is
	subdivided (CFrame:Lerp = linear position + slerped rotation, so arcs are followed) so the
	tip never travels more than SubstepDistance per substep. For every substep, each blade sample
	point (guard -> tip, edge side) casts a ray from its old to its new world position.

	Rays use the RR_HitQuery collision group, which only sees fighter bodies and blades (never the
	world or debris), and exclude the attacker's own model.

	Returns hits sorted by time-of-contact T in [0,1] across the frame, earliest per part.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.RagdollRonin.Config)
local SwordBuilder = require(script.Parent.SwordBuilder)
local Registry = require(script.Parent.Registry)

local HitDetection = {}
local C = Config.Combat
local SAMPLES = SwordBuilder.SamplePoints()

local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude
params.CollisionGroup = "RR_HitQuery"
params.IgnoreWater = true

-- Raycasts never report a part they START inside. A blade that is already resting in an
-- opponent's guard volume (e.g. wound up right next to it) would pass straight through the guard,
-- so guard volumes of blocking fighters are also tested with an explicit point-in-box check.
local function guardVolumes(f)
	local list = {}
	for _, other in pairs(Registry.ById) do
		if other ~= f and not other.Dead and other.Sword and other.Block and other.Block.Active then
			table.insert(list, other.Sword.ParryZone)
		end
	end
	return list
end

local function inside(zone, p)
	local l = zone.CFrame:PointToObjectSpace(p)
	local h = zone.Size / 2
	return math.abs(l.X) <= h.X and math.abs(l.Y) <= h.Y and math.abs(l.Z) <= h.Z
end

function HitDetection.Sweep(f, sweep)
	params.FilterDescendantsInstances = { f.Model }
	local zones = guardVolumes(f)
	local prevCF, cf, dt = sweep.PrevCF, sweep.CF, sweep.Dt
	local tip = SAMPLES[#SAMPLES]
	local travel = (cf:PointToWorldSpace(tip) - prevCF:PointToWorldSpace(tip)).Magnitude
	local n = math.clamp(math.ceil(travel / C.SubstepDistance), 1, C.MaxSubsteps)

	local earliest = {} -- part -> hit
	for i = 1, n do
		local cfA = prevCF:Lerp(cf, (i - 1) / n)
		local cfB = prevCF:Lerp(cf, i / n)
		for k, lp in ipairs(SAMPLES) do
			local a = cfA:PointToWorldSpace(lp)
			local b = cfB:PointToWorldSpace(lp)
			local d = b - a
			local len = d.Magnitude
			for _, zone in ipairs(zones) do
				if inside(zone, a) or inside(zone, b) then
					local t = (i - 1) / n + 0.001 * k
					local old = earliest[zone]
					if not old or t < old.T then
						earliest[zone] = {
							Part = zone,
							Position = inside(zone, a) and a or b,
							Normal = Vector3.yAxis,
							T = t,
							Sample = k,
							PointVel = (cf:PointToWorldSpace(lp) - prevCF:PointToWorldSpace(lp)) / dt,
						}
					end
				end
			end
			if len > 1e-3 then
				local res = workspace:Raycast(a, d, params)
				if res then
					local t = ((i - 1) + (res.Position - a).Magnitude / len) / n
					local old = earliest[res.Instance]
					if not old or t < old.T then
						earliest[res.Instance] = {
							Part = res.Instance,
							Position = res.Position,
							Normal = res.Normal,
							T = t,
							Sample = k,
							-- world velocity of this blade point over the frame
							PointVel = (cf:PointToWorldSpace(lp) - prevCF:PointToWorldSpace(lp)) / dt,
						}
					end
				end
			end
		end
	end
	local hits = {}
	for _, h in pairs(earliest) do
		table.insert(hits, h)
	end
	table.sort(hits, function(x, y)
		return x.T < y.T
	end)
	return hits
end

HitDetection.SampleCount = #SAMPLES
return HitDetection
]]></ProtectedString>
						<string name="ScriptGuid">{1D8941C4-F43F-4585-858D-1924B1B9AB01}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">HitDetection</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX8BC8053D2BD348E997E1E16F5D6D9567">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[-- Feedback: server -> client combat notifications for UI (never used as authority).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local remote = ReplicatedStorage.RagdollRonin.Remotes.CombatFeedback

local Feedback = {}

function Feedback.Send(f, kind, info)
	if f and f.Player and f.Player.Parent then
		remote:FireClient(f.Player, kind, info or {})
	end
end

return Feedback
]]></ProtectedString>
						<string name="ScriptGuid">{0B6417C6-CBC9-45CC-86F9-68288985867A}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">Feedback</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX45F7B6CFF254406B90ACAA4993746302">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[
	CombatResolver: turns swept contacts into authoritative outcomes.

	Strike power (no client-supplied numbers anywhere):
	  power = PowerScale * (relSpeed / RefSpeed)^2 * commitment * weapon * strokeEnergy * attackerStrength
	  relSpeed   = blade point velocity (from the sweep) minus the target surface velocity
	  commitment = stroke tip travel / CommitmentDistance (short flicks are weak)
	  strokeEnergy drops after every block, glance or body it passes through
	Contact classification:
	  Thrust - moving along the blade axis and contact near the tip
	  Cut    - relative motion aligned with the cutting edge (quality from alignment)
	  Blunt  - flat or spine contact

	Blade-vs-blade (the attacker's sweep reached the defender's sword or guard volume first):
	  defender blocking -> quality q = how perpendicular the guard is to the attack (1 - |axis.dir|),
	    must also be in front of the defender.
	      q < MinQuality or behind  -> Glance: attack slides on with reduced energy
	      power > guard*Overpower   -> Overpowered: guard broken, defender staggered, attack continues
	      raised within ParryWindow -> Parried: attacker deflected hard + staggered
	      otherwise                 -> Blocked: attacker deflected + recoil, defender pays balance
	  defender not blocking -> Clash (both deflect) if they were swinging, else Beat (blade knocked aside)
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.RagdollRonin
local Config = require(Shared.Config)
local Anatomy = require(Shared.Anatomy)
local StateDefs = require(Shared.StateDefs)
local Util = require(script.Parent.Util)
local Registry = require(script.Parent.Registry)
local AnatomyService = require(script.Parent.AnatomyService)
local Dismemberment = require(script.Parent.Dismemberment)
local BalanceController = require(script.Parent.BalanceController)
local SwordController = require(script.Parent.SwordController)
local StateMachine = require(script.Parent.StateMachine)
local BloodFX = require(script.Parent.BloodFX)
local Feedback = require(script.Parent.Feedback)
local DebugService = require(script.Parent.DebugService)
local HitDetection = require(script.Parent.HitDetection)

local CombatResolver = {}
local C = Config.Combat
local BK = Config.Block
local BL = Config.Balance
local S = Config.Scale
local MAX_REACH = (1.3 + 2.475) * S + Config.Sword.BladeLength + Config.Sword.HandleLength + C.ReachMargin

local killFn -- injected by Main (Lifecycle.Kill) to avoid a require cycle
function CombatResolver.SetKill(fn)
	killFn = fn
end

local function strikePower(att, stroke, relSpeed)
	local commitment = math.clamp(stroke.Distance / C.CommitmentDistance, C.MinCommitment, 1)
	local p = C.PowerScale * (relSpeed / C.RefSpeed) ^ 2 * commitment * Config.Sword.WeaponFactor * stroke.EnergyMult * att.Caps.Strength
	return math.min(p, C.MaxPower), commitment
end

local function plausible(att, target, h)
	if att.Dead or target.Dead or not att.Sword then
		return false, "dead/unarmed"
	end
	if att.Attack.TipSpeed > C.MaxPlausibleTipSpeed then
		return false, "tip speed"
	end
	local ut = att.Parts.UpperTorso
	if not ut or (h.Position - ut.Position).Magnitude > MAX_REACH then
		return false, "reach"
	end
	return true
end

local function deflect(f, dir, dv)
	if f.Sword and f.Sword.Handle.Parent then
		local h = f.Sword.Handle
		h:ApplyImpulse(Util.unit(dir, Vector3.yAxis) * dv * h.AssemblyMass)
	end
end

local function feedbackBoth(att, def, kindAtt, kindDef, info)
	Feedback.Send(att, kindAtt, info)
	Feedback.Send(def, kindDef, info)
end

------------------------------------------------------------------ blade contacts
-- returns "Stop" (stroke ends) or "Continue"
local function resolveBladeContact(att, def, h)
	local now = os.clock()
	local stroke = att.Attack.Stroke
	if not def.Sword or not def.Sword.Blade.Parent then
		return "Continue"
	end
	local defBlade = def.Sword.Blade
	local rel = h.PointVel - defBlade:GetVelocityAtPosition(h.Position)
	local speed = rel.Magnitude
	local dir = speed > 1e-3 and rel / speed or stroke.Dir
	local power = strikePower(att, stroke, speed)
	local q = 1 - math.abs(defBlade.CFrame.YVector:Dot(dir))
	local torso = def.Parts.UpperTorso
	local facing = Util.unit(Util.flat(def.Parts.LowerTorso.CFrame.LookVector), Vector3.zAxis)
	local inFront = torso and Util.unit(Util.flat(h.Position - torso.Position), facing):Dot(facing) > BK.FrontTolerance
	local info = { Power = math.floor(power * 10) / 10, Quality = math.floor(q * 100) / 100 }
	DebugService.Marker(h.Position, Color3.fromRGB(80, 160, 255), 0.45)

	if def.State == "Blocking" and def.Block.Active then
		local guard = BK.Strength * (0.35 + 0.65 * q) * def.Caps.SwordArm * def.Caps.Grip * def.Caps.Strength * (inFront and 1 or 0.35)
		local parry = inFront and q >= BK.ParryMinQuality and (now - def.Block.StartTime) <= BK.ParryWindow
		local outcome
		if q < BK.MinQuality or not inFront then
			outcome = "Glance"
			stroke.EnergyMult *= BK.GlanceEnergyMult
			stroke.GuardPassed[def.Id] = true
			def.Balance -= power * BK.BalanceCostPerPower * 0.3
			feedbackBoth(att, def, "AttackGlanced", "GuardGlanced", info)
		elseif power > guard * BK.OverpowerRatio and not parry then
			outcome = "Overpowered"
			stroke.EnergyMult *= BK.OverpowerEnergyMult
			stroke.GuardPassed[def.Id] = true
			def.Balance -= power * BK.BalanceCostPerPower * 1.5
			deflect(def, dir, C.DeflectDV)
			BalanceController.Stagger(def, C.StaggerTime, dir, "Guard overpowered")
			feedbackBoth(att, def, "GuardBroken", "GuardOverpowered", info)
		elseif parry then
			outcome = "Parried"
			deflect(att, -dir, C.ParryDeflectDV)
			SwordController.Recoil(att, C.ParryStaggerTime)
			BalanceController.Stagger(att, C.ParryStaggerTime, -dir, "Parried")
			feedbackBoth(att, def, "AttackParried", "Parried", info)
		else
			outcome = "Blocked"
			deflect(att, -dir, C.DeflectDV)
			deflect(def, dir, C.DeflectDV * 0.35)
			SwordController.Recoil(att, C.RecoilTime)
			def.Balance -= power * BK.BalanceCostPerPower
			if def.Balance <= BL.OffBalanceThreshold then
				BalanceController.Stagger(def, C.StaggerTime, dir, "Block pushed through")
			end
			feedbackBoth(att, def, "AttackBlocked", "Blocked", info)
		end
		DebugService.Attr(att, "LastBlock", outcome .. " by " .. def.Name)
		DebugService.Attr(def, "LastBlock", string.format("%s q=%.2f p=%.1f", outcome, q, power))
		DebugService.Log(att.Name, "->", def.Name, outcome, "q", q, "power", power)
		return (outcome == "Glance" or outcome == "Overpowered") and "Continue" or "Stop"
	end

	-- blades met outside a guard
	if def.Attack.Stroke then
		deflect(att, -dir, C.DeflectDV * 0.8)
		deflect(def, dir, C.DeflectDV * 0.8)
		SwordController.Recoil(att, C.RecoilTime * BK.ClashRecoilMult)
		SwordController.Recoil(def, C.RecoilTime * BK.ClashRecoilMult)
		feedbackBoth(att, def, "Clash", "Clash", info)
		DebugService.Attr(att, "LastBlock", "Clash")
		DebugService.Attr(def, "LastBlock", "Clash")
		return "Stop"
	end
	if power > BK.Strength * 0.5 then
		deflect(def, dir, C.DeflectDV)
		stroke.EnergyMult *= BK.BeatEnergyMult
		stroke.GuardPassed[def.Id] = true
		feedbackBoth(att, def, "BladeBeaten", "BladeKnockedAside", info)
		DebugService.Attr(def, "LastBlock", "Blade beaten aside")
		return "Continue"
	end
	deflect(att, -dir, C.DeflectDV * 0.6)
	SwordController.Recoil(att, C.RecoilTime * BK.ClashRecoilMult)
	feedbackBoth(att, def, "Clash", "Clash", info)
	return "Stop"
end

------------------------------------------------------------------ body contacts
local function react(att, target, h, dir, power, segName, strike)
	if target.Dead then
		return
	end
	local segDef = Anatomy.Segments[segName]
	local locMult = BL.LocationMult[segDef.BalanceClass] or 1
	local st = target.State
	local stateMult = (st == "Attacking" and BL.AttackingMult) or (st == "Blocking" and BL.BlockingMult)
		or ((st == "OffBalance" or st == "Staggered") and BL.OffBalanceMult) or 1
	local injuryMult = 1 + (1 - target.Caps.LegSupport) * 0.8
	local push = Util.unit(Util.flat(dir), Vector3.zAxis)

	-- bounded physical impulse on the struck segment
	if h.Part.Parent and Registry.FromPart(h.Part) == target then
		local dv = math.min(power * C.HitDVPerPower, C.MaxHitDV)
		h.Part:ApplyImpulse(dir * dv * h.Part.AssemblyMass)
	end

	target.Balance -= power * BL.CostPerPower * locMult * stateMult * injuryMult
	local effective = power * locMult * injuryMult
	local reaction = "Flinch"
	if StateDefs.Ground[st] or st == "Recovering" then
		if st == "Recovering" and effective >= C.StaggerPower then
			StateMachine.Set(target, "Falling", "Hit while getting up")
			reaction = "Knocked back down"
		end
	elseif effective >= C.KnockdownPower or target.Balance <= 0 then
		BalanceController.KnockDown(target, push, power, "Knocked down")
		reaction = "Knockdown"
		Feedback.Send(target, "KnockedDown", {})
	elseif effective >= C.StaggerPower
		or (st == "Attacking" and (segDef.BalanceClass == "Arm" or segDef.BalanceClass == "Hand") and power >= C.ArmInterruptPower) then
		local dur = effective >= C.StaggerPower * 1.8 and C.HeavyStaggerTime or C.StaggerTime
		if st == "Attacking" then
			Feedback.Send(target, "Interrupted", { Segment = segName })
		end
		BalanceController.Stagger(target, dur, push, "Hit " .. segDef.Label)
		reaction = "Stagger"
	elseif target.Balance < BL.OffBalanceThreshold then
		BalanceController.OffBalance(target, push, "Hit " .. segDef.Label)
		reaction = "OffBalance"
	end
	return reaction
end

local function resolveBodyHit(att, target, h)
	local segName = h.Part:GetAttribute("Segment")
	local stroke = att.Attack.Stroke
	if not segName or not stroke then
		return "Continue"
	end
	local key = target.Id .. ":" .. segName
	if stroke.Hits[key] then
		return "Continue"
	end
	local now = os.clock()
	local last = att.Attack.SegmentHitTimes[key]
	stroke.Hits[key] = true
	if last and now - last < C.SegmentCooldown then
		return "Continue"
	end
	local ok, why = plausible(att, target, h)
	if not ok then
		DebugService.Log("rejected hit", att.Name, "->", target.Name, why)
		return "Continue"
	end
	att.Attack.SegmentHitTimes[key] = now

	local blade = att.Sword.Blade.CFrame
	local rel = h.PointVel - h.Part:GetVelocityAtPosition(h.Position)
	local speed = rel.Magnitude
	if speed < 1e-3 then
		return "Continue"
	end
	local dir = rel / speed
	local power, commitment = strikePower(att, stroke, speed)
	local axial = dir:Dot(blade.YVector)
	local edgeDot = dir:Dot(blade.XVector)
	local kind, quality
	if axial > C.ThrustAxialDot and h.Sample >= HitDetection.SampleCount - 1 then
		kind = "Thrust"
		quality = 0.4 + 0.6 * math.clamp((axial - C.ThrustAxialDot) / (1 - C.ThrustAxialDot), 0, 1)
	elseif edgeDot > C.CutEdgeDot then
		kind = "Cut"
		quality = math.clamp((edgeDot - C.CutEdgeDot) / (0.85 - C.CutEdgeDot), 0.25, 1)
	else
		kind = "Blunt"
		quality = C.BluntQuality
	end

	DebugService.Marker(h.Position, Color3.fromRGB(255, 60, 40))
	DebugService.Attr(att, "LastContact", string.format("%s %s v=%.0f", target.Name, segName, speed))
	DebugService.Attr(att, "LastTargetSegment", segName)

	if power < C.MinDamagingPower then
		stroke.EnergyMult *= 0.9
		DebugService.Log(att.Name, "touched", target.Name, segName, "power", power)
		Feedback.Send(att, "Contact", { Segment = segName })
		return "Continue"
	end

	local strike = AnatomyService.ApplyStrike(target, {
		Segment = segName,
		Part = h.Part,
		Position = h.Position,
		Direction = dir,
		BladeAxis = blade.YVector,
		Power = power,
		Kind = kind,
		Quality = quality,
	})
	stroke.EnergyMult *= strike.EnergyRemaining
	BloodFX.WoundMark(target, h.Part, h.Position, h.Normal, strike.Damage / 40)
	if strike.Outcome ~= "Stopped" then
		BloodFX.Source(target, segName, h.Part, CFrame.new(h.Position))
		BloodFX.Burst(h.Part, h.Position, strike.Damage * 0.5)
	end

	local severed = nil
	if strike.SeverBoundary then
		local distal = Dismemberment.Sever(target, strike.SeverBoundary, dir, power)
		if distal then
			severed = strike.SeverBoundary
			AnatomyService.OnSevered(target, strike.SeverBoundary, distal)
		end
	end
	-- crippled sword hand loses the sword (also enforced every frame in Main)
	if target.Sword and target.Anatomy.Segments.RightHand.Integrity < Config.Anatomy.DisarmHandIntegrity then
		Dismemberment.DropSword(target, dir * 8)
	end

	local reaction = react(att, target, h, dir, power, segName, strike)
	local summary = string.format("%s p=%.1f q=%.2f c=%.2f %s%s -> %s", kind, power, quality, commitment, strike.Summary or "",
		severed and (" SEVERED " .. severed) or "", tostring(reaction))
	DebugService.Attr(target, "LastInjury", summary)
	DebugService.Log(att.Name, "hit", target.Name, summary)

	local fatal = AnatomyService.CheckFatal(target)
	if fatal and killFn then
		killFn(target, fatal, att)
	end

	local info = { Segment = segName, Label = Anatomy.Segments[segName].Label, Kind = kind, Power = math.floor(power * 10) / 10, Outcome = strike.Outcome, Severed = severed, Fatal = fatal }
	Feedback.Send(att, "Hit", info)
	Feedback.Send(target, "Hurt", info)
	return "Continue"
end

------------------------------------------------------------------ entry
function CombatResolver.Process(att, hits)
	for idx, h in ipairs(hits) do
		local stroke = att.Attack.Stroke
		if not stroke or att.Dead then
			return
		end
		local target = Registry.FromPart(h.Part)
		if target and target ~= att and not target.Dead then
			local result = "Continue"
			if h.Part:GetAttribute("SwordPart") then
				if not stroke.GuardPassed[target.Id] then
					result = resolveBladeContact(att, target, h)
				end
			else
				-- tolerance: a guard contact just after this body contact still intercepts it
				if not stroke.GuardPassed[target.Id] then
					for j = idx + 1, #hits do
						local g = hits[j]
						if g.T > h.T + C.GuardTimeTolerance then
							break
						end
						if g.Part:GetAttribute("SwordPart") and Registry.FromPart(g.Part) == target then
							result = resolveBladeContact(att, target, g)
							break
						end
					end
				end
				if result == "Continue" and att.Attack.Stroke then
					result = resolveBodyHit(att, target, h)
				end
			end
			if result == "Stop" then
				SwordController.EndStroke(att, "Stopped")
				return
			end
		end
	end
end

return CombatResolver
]]></ProtectedString>
						<string name="ScriptGuid">{8B28DCF3-E189-4B4D-88B3-C8836D4A72D9}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">CombatResolver</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX75AED91E45CF45F9B42078C85708E4D4">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[
	BleedingService: one bounded tick (Config.Blood.TickInterval) for all fighters - no per-wound loops.
	bleed rate = segment wounds (clot exponentially) + damaged organs/vessels (no clotting,
	             proportional to damage) + severed stumps (clot slowly)
	Consequences: capabilities weaken (UpdateCaps), incapacitation, death at the lethal threshold.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.RagdollRonin
local Config = require(Shared.Config)
local Anatomy = require(Shared.Anatomy)
local Registry = require(script.Parent.Registry)
local AnatomyService = require(script.Parent.AnatomyService)
local BloodFX = require(script.Parent.BloodFX)

local BleedingService = {}
local B = Config.Blood

function BleedingService.Tick(dt, killFn)
	for _, f in ipairs(Registry.List()) do
		if not f.Dead then
			local A = f.Anatomy
			local rate = 0
			local woundDecay = math.exp(-B.WoundClotRate * dt)
			for _, rec in pairs(A.Segments) do
				if rec.Bleeding > 0 then
					rec.Bleeding *= woundDecay
					if rec.Bleeding < 0.2 then
						rec.Bleeding = 0
					end
					rate += rec.Bleeding
				end
			end
			for _, o in ipairs(Anatomy.Organs) do
				local h = A.Organs[o.Name].Health
				if h < 100 then
					rate += o.BleedRate * (1 - h / 100)
				end
			end
			local stumpDecay = math.exp(-B.StumpClotRate * dt)
			for _, s in pairs(A.Stumps) do
				s.Rate *= stumpDecay
				rate += s.Rate
			end
			rate = math.min(rate, B.MaxBleedRate)
			local prevBlood = A.Blood
			A.BleedRate = rate
			A.Blood = math.max(0, A.Blood - rate * dt)
			if rate > 0 or prevBlood ~= A.Blood then
				f.AnatomyDirty = true
			end
			AnatomyService.EvaluateVitals(f)
			AnatomyService.UpdateCaps(f)
			BloodFX.Update(f)
			f.Model:SetAttribute("BloodFrac", math.floor(A.Blood / B.Max * 100) / 100)
			local reason = AnatomyService.CheckFatal(f)
			if reason and killFn then
				killFn(f, reason)
			end
		else
			BloodFX.Update(f)
		end
	end
end

return BleedingService
]]></ProtectedString>
						<string name="ScriptGuid">{B2B21FEF-6E98-4264-B4D6-5D3A84CCC60A}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">BleedingService</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX8F704844B2EA4CE5AAE14AA9AB4789E6">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[
	Lifecycle: spawning, death, respawning and cleanup for custom fighters.

	Players.CharacterAutoLoads is disabled so Roblox never spawns a default rig. The server builds
	a custom fighter and assigns it as Player.Character (it has no Humanoid). Death is decided only
	by the anatomy/blood rules; the corpse stays physically simulated, then becomes debris when the
	player respawns after Config.Lifecycle.RespawnDelay. Death is processed exactly once.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.RagdollRonin.Config)
local Registry = require(script.Parent.Registry)
local CharacterBuilder = require(script.Parent.CharacterBuilder)
local AnatomyService = require(script.Parent.AnatomyService)
local Input = require(script.Parent.Input)
local BalanceController = require(script.Parent.BalanceController)
local SwordController = require(script.Parent.SwordController)
local StateMachine = require(script.Parent.StateMachine)
local Dismemberment = require(script.Parent.Dismemberment)
local Feedback = require(script.Parent.Feedback)
local DebugService = require(script.Parent.DebugService)

local Lifecycle = {}

local GI_COLORS = {
	Color3.fromRGB(46, 58, 92), Color3.fromRGB(110, 34, 38), Color3.fromRGB(40, 78, 56),
	Color3.fromRGB(88, 70, 40), Color3.fromRGB(70, 46, 96), Color3.fromRGB(36, 84, 96),
}

local groundParams = RaycastParams.new()
groundParams.CollisionGroup = "RR_GroundQuery"

local function spawnCFrame(position)
	local center = Vector3.zero
	local spawnLoc = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	if spawnLoc then
		center = spawnLoc.Position
	end
	local pos = position
	if not pos then
		local a = math.random() * math.pi * 2
		local r = Config.Lifecycle.SpawnRadius * (0.4 + 0.6 * math.random())
		pos = center + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
	end
	local hit = workspace:Raycast(pos + Vector3.new(0, 50, 0), Vector3.new(0, -200, 0), groundParams)
	local ground = hit and hit.Position or pos
	local toCenter = Vector3.new(center.X - ground.X, 0, center.Z - ground.Z)
	local yaw = toCenter.Magnitude > 0.5 and math.atan2(-toCenter.X, -toCenter.Z) or 0
	return CFrame.new(ground) * CFrame.Angles(0, yaw, 0), yaw
end

-- opts: { Name, Position, Yaw, RespawnDummy }
function Lifecycle.Spawn(player, opts)
	opts = opts or {}
	local cf, yaw = spawnCFrame(opts.Position)
	if opts.Yaw then
		yaw = opts.Yaw
		cf = CFrame.new(cf.Position) * CFrame.Angles(0, yaw, 0)
	end
	local id = Registry.NewId()
	local name = opts.Name or (player and player.Name) or ("Dummy" .. id)
	local gi = GI_COLORS[((player and player.UserId or id) % #GI_COLORS) + 1]
	local data = CharacterBuilder.Build(cf, { Name = name, GiColor = gi })

	local f = {
		Id = id,
		Name = name,
		Player = player,
		IsDummy = player == nil,
		RespawnDummy = opts.RespawnDummy,
		Model = data.Model,
		Parts = data.Parts,
		DetachedParts = {},
		Joints = data.Joints,
		Adjacency = data.Adjacency,
		Drives = data.Drives,
		Sword = data.Sword,
		TotalMass = data.TotalMass,
		DriveCache = setmetatable({}, { __mode = "k" }),
		Dead = false,
		SpawnTime = os.clock(),
	}
	data.Model:SetAttribute("FighterId", id)
	if player then
		data.Model:SetAttribute("OwnerUserId", player.UserId)
	end

	AnatomyService.Create(f)
	Input.Init(f, yaw)
	BalanceController.Init(f, yaw)
	SwordController.Init(f)
	StateMachine.Init(f)

	data.Model.Parent = workspace
	CharacterBuilder.ClaimOwnership(data.Model)
	Registry.Add(f)
	if player then
		player.Character = data.Model
	end
	f.AnatomyDirty = true
	DebugService.Log("spawned", name, "mass", data.TotalMass)
	return f
end

function Lifecycle.Despawn(f, keepCorpse)
	if f.Removed then
		return
	end
	f.Removed = true
	Registry.Remove(f)
	local model = f.Model
	-- The engine destroys a player's previous Character model when the character is reassigned,
	-- so the corpse keeps the body's contents in a separate model.
	if keepCorpse and model.Parent and f.Player then
		local corpse = Instance.new("Model")
		corpse.Name = model.Name
		corpse.Parent = Registry.DebrisFolder()
		for _, c in ipairs(model:GetChildren()) do
			c.Parent = corpse
		end
		corpse.PrimaryPart = corpse:FindFirstChild("LowerTorso")
		if f.Player.Character == model then
			f.Player.Character = nil
		end
		model:Destroy()
		model = corpse
	elseif f.Player and f.Player.Character == model then
		f.Player.Character = nil
	end
	if keepCorpse and model.Parent then
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("AlignOrientation") or d:IsA("AlignPosition") or d:IsA("LinearVelocity") or d:IsA("VectorForce") then
				d:Destroy()
			elseif d:IsA("HingeConstraint") then
				d.ActuatorType = Enum.ActuatorType.None
			elseif d:IsA("BasePart") then
				d.CollisionGroup = "RR_Debris"
				d.CanQuery = false
			end
		end
		model.Name = "Corpse_" .. f.Name
		model.Parent = Registry.DebrisFolder()
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				pcall(d.SetNetworkOwnershipAuto, d)
			end
		end
		Dismemberment.TrackDebris(model, Config.Dismemberment.CorpseLifetime)
	else
		model:Destroy()
	end
end

function Lifecycle.Respawn(f)
	if f.Removed then
		return
	end
	local player = f.Player
	local respawnDummy = f.RespawnDummy
	local name = f.Name
	Lifecycle.Despawn(f, true)
	if player and player.Parent then
		Lifecycle.Spawn(player)
	elseif respawnDummy then
		Lifecycle.Spawn(nil, { Name = name, RespawnDummy = true })
	end
end

-- Single entry point for death. Idempotent.
function Lifecycle.Kill(f, reason, killer)
	if f.Dead then
		return
	end
	f.Dead = true
	f.DeathReason = reason
	SwordController.EndStroke(f, "Dead")
	StateMachine.ForceDead(f, reason)
	DebugService.Attr(f, "DeathReason", reason)
	f.AnatomyDirty = true
	Feedback.Send(f, "Died", { Reason = reason, Respawn = Config.Lifecycle.RespawnDelay })
	if killer and killer ~= f then
		Feedback.Send(killer, "Killed", { Target = f.Name, Reason = reason })
	end
	print(string.format("[RR] %s died: %s", f.Name, reason))
	task.delay(Config.Lifecycle.RespawnDelay, function()
		Lifecycle.Respawn(f)
	end)
end

-- Detects bodies that were destroyed or fell out of the world
function Lifecycle.Validate(f)
	local pelvis = f.Parts.LowerTorso
	if not f.Model.Parent or not pelvis or not pelvis:IsDescendantOf(workspace) then
		if not f.Dead then
			Lifecycle.Kill(f, "Body lost")
		end
		return false
	end
	if not f.Dead and pelvis.Position.Y < workspace.FallenPartsDestroyHeight + 25 then
		Lifecycle.Kill(f, "Fell out of the world")
	end
	return true
end

function Lifecycle.Init()
	Players.CharacterAutoLoads = false
	local function onPlayer(player)
		task.delay(Config.Lifecycle.FirstSpawnDelay, function()
			if player.Parent and not Registry.ByPlayer[player] then
				Lifecycle.Spawn(player)
			end
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in ipairs(Players:GetPlayers()) do
		onPlayer(p)
	end
	Players.PlayerRemoving:Connect(function(player)
		local f = Registry.ByPlayer[player]
		if f then
			Lifecycle.Despawn(f, false)
		end
	end)
end

return Lifecycle
]]></ProtectedString>
						<string name="ScriptGuid">{EA6EE042-FEAA-467C-8EE1-ED28AADB0D02}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">Lifecycle</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXC4925BD8E4474184A89A79FC03F68393">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[
	NetService: the only entry points from clients.

	CombatInput (UnreliableRemoteEvent, ~30 Hz): seq, moveX, moveZ, yaw, aimU, aimV, buttons
	  * token-bucket rate limit per player; malformed or non-finite packets are dropped
	  * out-of-order packets (seq not increasing) are dropped
	  * move clamped to unit length, aim clamped to the unit disk, buttons masked to 2 bits
	  The server converts this INTENT into motion itself (speed caps, inertia, physical drives),
	  so no packet can move the sword faster than physics allows or declare a hit/damage.
	CombatAction (RemoteEvent): "Recover" | "Reset", cooldown limited.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage.RagdollRonin
local Config = require(Shared.Config)
local Registry = require(script.Parent.Registry)
local Util = require(script.Parent.Util)
local BalanceController = require(script.Parent.BalanceController)
local DebugService = require(script.Parent.DebugService)

local NetService = {}
local N = Config.Network
local buckets = {}
local actionTimes = {}
local rejects = {}

local function allow(player)
	local now = os.clock()
	local b = buckets[player]
	if not b then
		b = { Tokens = N.BucketCapacity, Last = now }
		buckets[player] = b
	end
	b.Tokens = math.min(N.BucketCapacity, b.Tokens + (now - b.Last) * N.BucketRefillPerSecond)
	b.Last = now
	if b.Tokens < 1 then
		return false
	end
	b.Tokens -= 1
	return true
end

local function reject(player, why)
	rejects[player] = (rejects[player] or 0) + 1
	if DebugService.Enabled() and rejects[player] % 50 == 1 then
		warn("[RR] rejected input from", player.Name, why, "total", rejects[player])
	end
end

function NetService.RejectCount(player)
	return rejects[player] or 0
end

local function onInput(player, seq, mx, mz, yaw, u, v, buttons)
	if not allow(player) then
		return reject(player, "rate")
	end
	local f = Registry.ByPlayer[player]
	if not f or f.Dead then
		return
	end
	local args = { seq, mx, mz, yaw, u, v, buttons }
	for k = 1, 7 do -- numeric loop: ipairs would stop at a nil and let it through
		if not Util.isFinite(args[k]) then
			return reject(player, "malformed")
		end
	end
	local i = f.Input
	if seq <= i.Seq then
		-- small step back = reordered/duplicate packet: drop. A large jump back means the client's
		-- counter restarted (script reload); accept it so input can never be locked out.
		if i.Seq - seq < 1000 then
			return
		end
	end
	local move = Vector3.new(mx, 0, mz)
	if move.Magnitude > 1 then
		move = move.Unit
	end
	local r = math.sqrt(u * u + v * v)
	if r > 1 then
		u, v = u / r, v / r
	end
	buttons = math.floor(buttons) % 4
	i.Seq = seq
	i.Move = move
	i.Yaw = yaw % (2 * math.pi)
	i.AimU = u
	i.AimV = v
	i.M1 = buttons % 2 == 1
	i.M2 = buttons >= 2
	i.LastPacket = os.clock()
end

local resetFn
function NetService.SetReset(fn)
	resetFn = fn
end

local function onAction(player, action)
	if typeof(action) ~= "string" or #action > 16 then
		return reject(player, "bad action")
	end
	local now = os.clock()
	local key = player.UserId .. action
	if actionTimes[key] and now - actionTimes[key] < N.ActionCooldown then
		return
	end
	actionTimes[key] = now
	local f = Registry.ByPlayer[player]
	if not f or f.Dead then
		return
	end
	if action == "Recover" then
		BalanceController.RequestRecover(f)
	elseif action == "Reset" and resetFn then
		resetFn(f)
	end
end

function NetService.Init()
	local remotes = Shared.Remotes
	remotes.CombatInput.OnServerEvent:Connect(onInput)
	remotes.CombatAction.OnServerEvent:Connect(onAction)
	Players.PlayerRemoving:Connect(function(p)
		buckets[p] = nil
		rejects[p] = nil
	end)
end

return NetService
]]></ProtectedString>
						<string name="ScriptGuid">{6914F793-5B72-46BF-A23F-BFCAA1D972C3}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">NetService</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXC2E0BC3F6ACC453A98D954C4A6BFEB84">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--[[
	DevTools (Studio only): a BindableFunction ServerStorage.RR_DevCommand used for repeatable tests.
	Not created in live servers. Dummies are ordinary fighters driven by an input override - they run
	through exactly the same controllers, hit detection and anatomy as players.

	Examples (server command bar during Play):
	  local dev = game.ServerStorage.RR_DevCommand
	  local id = dev:Invoke("spawnDummy", { Position = Vector3.new(0,0,-6), Yaw = math.pi })
	  dev:Invoke("setInput", id, { M2 = true, AimU = -0.8, AimV = 0 })
	  print(dev:Invoke("status", id))
]]
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.RagdollRonin
local Config = require(Shared.Config)
local Anatomy = require(Shared.Anatomy)
local Registry = require(script.Parent.Registry)
local Input = require(script.Parent.Input)
local AnatomyService = require(script.Parent.AnatomyService)
local Dismemberment = require(script.Parent.Dismemberment)
local CombatResolver = require(script.Parent.CombatResolver)

local DevTools = {}

local function fighterSummary(f)
	local A = f.Anatomy
	local segs = {}
	for name, rec in pairs(A.Segments) do
		if rec.Integrity < 100 or rec.Severed or rec.Bleeding > 0 then
			segs[name] = string.format("i=%.0f b=%.1f%s%s", rec.Integrity, rec.Bleeding, rec.Severed and " SEVERED" or "", rec.Lost and " LOST" or "")
		end
	end
	local organs = {}
	for name, rec in pairs(A.Organs) do
		if rec.Health < 100 then
			organs[name] = math.floor(rec.Health)
		end
	end
	local pelvis = f.Parts.LowerTorso
	return {
		Id = f.Id,
		Name = f.Name,
		State = f.State,
		StateReason = f.Model:GetAttribute("StateReason"),
		AttackPhase = f.Attack.Phase,
		TipSpeed = math.floor(f.Attack.TipSpeed * 10) / 10,
		Balance = math.floor(f.Balance),
		Blood = math.floor(A.Blood),
		BleedRate = math.floor(A.BleedRate * 10) / 10,
		Incapacitated = A.Incapacitated,
		PendingDeath = A.PendingDeath and A.PendingDeath.Reason,
		Dead = f.Dead,
		DeathReason = f.DeathReason,
		HasSword = f.Sword ~= nil,
		Caps = {
			LegSupport = math.floor(f.Caps.LegSupport * 100) / 100,
			SwordArm = math.floor(f.Caps.SwordArm * 100) / 100,
			Grip = math.floor(f.Caps.Grip * 100) / 100,
			Move = math.floor(f.Caps.Move * 100) / 100,
			Strength = math.floor(f.Caps.Strength * 100) / 100,
			Kneeling = f.Caps.Kneeling,
		},
		Position = pelvis and pelvis.Position,
		Height = f.Ground and math.floor(f.Ground.Height * 100) / 100,
		UpDot = f.UpDot and math.floor(f.UpDot * 100) / 100,
		Segments = segs,
		Organs = organs,
		Stumps = (function()
			local t = {}
			for k, s in pairs(A.Stumps) do
				t[k] = math.floor(s.Rate)
			end
			return t
		end)(),
		Log = A.InjuryLog,
		History = f.StateHistory,
		LastBlock = f.Model:GetAttribute("LastBlock"),
		LastInjury = f.Model:GetAttribute("LastInjury"),
	}
end

-- Deterministic anatomy test: apply a strike to a segment without physics (dev only)
local function testStrike(f, segName, power, kind, quality, fromDir, kill)
	local partName = Anatomy.SegmentParts[segName] and Anatomy.SegmentParts[segName][1]
	local part = partName and f.Parts[partName]
	if not part then
		return "segment not attached"
	end
	local dir = (fromDir or -part.CFrame.LookVector).Unit -- default: from the front, inward
	local pos = part.Position - dir * (math.max(part.Size.X, part.Size.Z) * 0.5)
	local strike = AnatomyService.ApplyStrike(f, {
		Segment = segName, Part = part, Position = pos, Direction = dir, BladeAxis = dir,
		Power = power, Kind = kind or "Cut", Quality = quality or 1,
	})
	if strike.SeverBoundary then
		local distal = Dismemberment.Sever(f, strike.SeverBoundary, dir, power)
		if distal then
			AnatomyService.OnSevered(f, strike.SeverBoundary, distal)
		end
	end
	local fatal = AnatomyService.CheckFatal(f)
	if fatal and kill then
		kill(f, fatal)
	end
	return { Summary = strike.Summary, Sever = strike.SeverBoundary, Fatal = fatal, Organs = strike.Organs }
end

function DevTools.Init(api)
	if not RunService:IsStudio() or not Config.Debug.DevToolsInStudio then
		return
	end
	local bf = ServerStorage:FindFirstChild("RR_DevCommand") or Instance.new("BindableFunction")
	bf.Name = "RR_DevCommand"
	bf.Parent = ServerStorage
	bf.OnInvoke = function(cmd, a, b, c, d, e)
		if cmd == "spawnDummy" then
			a = a or {}
			local f = api.Spawn(nil, { Name = a.Name, Position = a.Position, Yaw = a.Yaw, RespawnDummy = a.Respawn })
			return f.Id
		elseif cmd == "setInput" then
			local f = Registry.ById[a]
			if not f then
				return false
			end
			local i = Input.Neutral()
			i.Yaw = f.FacingYaw
			for k, v in pairs(b or {}) do
				i[k] = v
			end
			f.InputOverride = i
			return true
		elseif cmd == "clearInput" then
			local f = Registry.ById[a]
			if f then
				f.InputOverride = nil
			end
			return true
		elseif cmd == "status" then
			if a then
				local f = Registry.ById[a]
				return f and fighterSummary(f) or nil
			end
			local all = {}
			for _, f in ipairs(Registry.List()) do
				table.insert(all, fighterSummary(f))
			end
			return all
		elseif cmd == "list" then
			local ids = {}
			for _, f in ipairs(Registry.List()) do
				ids[f.Name] = f.Id
			end
			return ids
		elseif cmd == "playerFighter" then
			local p = a and Players:FindFirstChild(a) or Players:GetPlayers()[1]
			local f = p and Registry.ByPlayer[p]
			return f and f.Id
		elseif cmd == "kill" then
			local f = Registry.ById[a]
			if f then
				api.Kill(f, b or "Dev kill")
			end
			return true
		elseif cmd == "remove" then
			local f = Registry.ById[a]
			if f then
				api.Despawn(f, false)
			end
			return true
		elseif cmd == "impulse" then
			local f = Registry.ById[a]
			local part = f and f.Parts[b]
			if part then
				part:ApplyImpulse(c * part.AssemblyMass)
			end
			return part ~= nil
		elseif cmd == "knockdown" then
			local f = Registry.ById[a]
			if f then
				api.KnockDown(f, b or Vector3.new(0, 0, 1), c or 10)
			end
			return true
		elseif cmd == "testStrike" then
			local f = Registry.ById[a]
			if not f then
				return "no fighter"
			end
			local opts = c or {}
			return testStrike(f, b, opts.Power or 5, opts.Kind, opts.Quality, opts.Dir, api.Kill)
		elseif cmd == "teleport" then
			local f = Registry.ById[a]
			if f then
				f.Model:PivotTo(b)
			end
			return true
		elseif cmd == "setDebug" then
			workspace:SetAttribute("RR_Debug", a == true)
			return true
		end
		return "unknown command " .. tostring(cmd)
	end
end

return DevTools
]]></ProtectedString>
